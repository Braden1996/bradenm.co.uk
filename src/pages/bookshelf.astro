---
import bookshelfData from "../../data/bookshelf.json";
import bookshelfCoverManifestJson from "../../data/bookshelf-covers.json?raw";
import BookshelfResultsCount from "../features/bookshelf/molecules/bookshelf-results-count.astro";
import { buildBookshelfViewModel } from "../features/bookshelf/lib/bookshelf-data";
import BookshelfTemplate from "../features/bookshelf/templates/bookshelf-template.astro";
import Layout from "../layouts/layout.astro";

const bookshelfCoverManifest = JSON.parse(String(bookshelfCoverManifestJson)) as {
  covers?: Record<
    string,
    {
      height?: number;
      src?: string;
      width?: number;
    }
  >;
};

const { books, payload } = buildBookshelfViewModel(
  bookshelfData as { author: string; medium: string; title: string }[],
  bookshelfCoverManifest.covers ?? {},
);
const payloadJson = JSON.stringify(payload);

const pageDescription =
  "Search Braden Marshall's personal bookshelf across physical, audiobook, and Kindle editions.";
---

<Layout title="Bookshelf | Braden Marshall" description={pageDescription} activeTab="bookshelf">
  <BookshelfTemplate books={books} />

  <BookshelfResultsCount slot="footer-center" total={books.length} />

  <script id="bookshelf-data" type="application/json" is:inline set:html={payloadJson} />
  <script>
    import "../features/bookshelf/client/bookshelf";
  </script>
</Layout>

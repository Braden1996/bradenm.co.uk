---
import bookshelfData from "../../data/bookshelf.json";
import bookshelfCoverManifestJson from "../../data/bookshelf-covers.json?raw";

import AnimatedChevronIcon from "../components/animated-chevron-icon.astro";
import MediumTagGroup from "../components/medium-tag-group.astro";
import OverlaySearchBar from "../components/overlay-search-bar.astro";
import ProgressiveImage from "../components/progressive-image.astro";
import ScrollFadeFrame from "../components/scroll-fade-frame.astro";
import Layout from "../layouts/layout.astro";

type Book = {
  id: string;
  title: string;
  author: string;
  mediums: string[];
  firstIndex: number;
  sortTitle: string;
  sortAuthor: string;
  coverHue: number;
  coverHeight: number;
  coverSrc: string;
  coverPlaceholderDataUrl: string;
  coverWidth: number;
  cacheKey: string;
};

type GroupedBook = Omit<Book, "mediums"> & {
  mediumSet: Set<string>;
};

type AuthorSegment = {
  label: string;
  separator: string;
};

const mediumOrder = ["Physical", "Audiobook", "Kindle"] as const;
const bookshelfCoverManifest = JSON.parse(String(bookshelfCoverManifestJson)) as {
  covers?: Record<
    string,
    {
      height?: number;
      src?: string;
      placeholderDataUrl?: string;
      width?: number;
    }
  >;
};
const coverMap = bookshelfCoverManifest.covers ?? {};
const sourceRows = (bookshelfData as { title: string; author: string; medium: string }[]).map(
  (row, index) => ({
    ...row,
    index,
  }),
);

function normalizeText(value: string) {
  return value
    .normalize("NFKD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function hashText(value: string) {
  let hash = 0;

  for (const character of value) {
    hash = (hash * 31 + character.charCodeAt(0)) >>> 0;
  }

  return hash;
}

function stripLeadingArticle(value: string) {
  const trimmed = value.trim();
  const withoutLeadingMarks = trimmed.replace(/^[^A-Za-z0-9]+/, "");
  const withoutArticle = withoutLeadingMarks.replace(/^(?:the|an|a)\s+/i, "");

  return withoutArticle || withoutLeadingMarks || trimmed;
}

function splitAuthorSegments(author: string) {
  const segments: AuthorSegment[] = [];
  const separatorPattern = /\s*([&/+])\s*|\s+(and)\s+/gi;
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  while ((match = separatorPattern.exec(author)) !== null) {
    const label = author.slice(lastIndex, match.index).trim();
    const separator = (match[1] ?? match[2] ?? "").trim();

    if (label) {
      segments.push({ label, separator });
    }

    lastIndex = separatorPattern.lastIndex;
  }

  const trailingLabel = author.slice(lastIndex).trim();

  if (trailingLabel) {
    segments.push({ label: trailingLabel, separator: "" });
  }

  return segments.length > 0 ? segments : [{ label: author.trim(), separator: "" }];
}

const groupedBooks = new Map<string, GroupedBook>();

for (const row of sourceRows) {
  const author = row.author || "Unknown author";
  const key = `${normalizeText(row.title)}::${normalizeText(author)}`;
  const existing = groupedBooks.get(key);

  if (existing) {
    existing.mediumSet.add(row.medium);
    continue;
  }

  const seed = hashText(`${row.title}::${author}`);

  groupedBooks.set(key, {
    id: `book-${groupedBooks.size + 1}`,
    title: row.title,
    author,
    mediumSet: new Set([row.medium]),
    firstIndex: row.index,
    sortTitle: stripLeadingArticle(row.title),
    sortAuthor: author.trim(),
    coverHue: 28 + (seed % 250),
    coverHeight: coverMap[key]?.height ?? 0,
    coverSrc: coverMap[key]?.src ?? "",
    coverPlaceholderDataUrl: coverMap[key]?.placeholderDataUrl ?? "",
    coverWidth: coverMap[key]?.width ?? 0,
    cacheKey: key,
  });
}

const books = [...groupedBooks.values()].map((groupedBook) => {
  const {
    mediumSet,
    id,
    title,
    author,
    firstIndex,
    sortTitle,
    sortAuthor,
    coverHue,
    coverHeight,
    coverSrc,
    coverPlaceholderDataUrl,
    coverWidth,
    cacheKey,
  } = groupedBook;
  const orderedMediums = [
    ...mediumOrder.filter((medium) => mediumSet.has(medium)),
    ...[...mediumSet]
      .filter((medium) => !mediumOrder.includes(medium as (typeof mediumOrder)[number]))
      .toSorted((left, right) => left.localeCompare(right)),
  ];

  return {
    id,
    title,
    author,
    firstIndex,
    sortTitle,
    sortAuthor,
    coverHue,
    coverHeight,
    coverSrc,
    coverPlaceholderDataUrl,
    coverWidth,
    cacheKey,
    mediums: orderedMediums,
  };
});

const defaultCollator = new Intl.Collator("en-GB", {
  ignorePunctuation: true,
  numeric: true,
  sensitivity: "base",
});
books.sort(
  (a, b) =>
    defaultCollator.compare(a.sortTitle, b.sortTitle) ||
    defaultCollator.compare(a.sortAuthor, b.sortAuthor) ||
    a.firstIndex - b.firstIndex,
);

const booksData = books.map((book) => ({
  id: book.id,
  title: book.title,
  author: book.author,
  firstIndex: book.firstIndex,
  sortAuthor: book.sortAuthor,
  sortTitle: book.sortTitle,
  coverSrc: book.coverSrc,
  cacheKey: book.cacheKey,
}));

const pageDescription =
  "Search Braden Marshall's personal bookshelf across physical, audiobook, and Kindle editions.";
---

<Layout title="Bookshelf | Braden Marshall" description={pageDescription} activeTab="bookshelf">
  <div class="bookshelf-page" data-bookshelf-page>
    <div class="bookshelf-header">
      <div class="bookshelf-column-headings">
        <OverlaySearchBar
          class="bookshelf-heading-search"
          id="bookshelf-search"
          label="Search the shelf"
          mode="heading"
          placeholder="Search titles or authors"
        >
          <button
            slot="heading-meta"
            class="bookshelf-sort-toggle bookshelf-sort-toggle--desktop"
            type="button"
            data-sort-toggle="title"
            data-sort-label="title"
            data-sort-direction="asc"
            aria-label="Sort by title. Currently ascending."
            aria-pressed="true"
          >
            <span class="bookshelf-sort-label-text">Title</span>
            <AnimatedChevronIcon class="bookshelf-sort-icon" />
          </button>
        </OverlaySearchBar>
        <span class="bookshelf-column-label bookshelf-column-label--title-author">
          <button
            class="bookshelf-sort-toggle bookshelf-sort-toggle--mobile"
            type="button"
            data-sort-toggle="title"
            data-sort-label="title"
            data-sort-direction="asc"
            aria-label="Sort by title. Currently ascending."
            aria-pressed="true"
          >
            <span class="bookshelf-sort-label-text">Title</span>
            <AnimatedChevronIcon class="bookshelf-sort-icon" />
          </button>
          <button
            class="bookshelf-sort-toggle bookshelf-sort-toggle--mobile"
            type="button"
            data-sort-toggle="author"
            data-sort-label="author"
            data-sort-direction="none"
            aria-label="Sort by author."
            aria-pressed="false"
          >
            <span class="bookshelf-sort-label-text">Author</span>
            <AnimatedChevronIcon class="bookshelf-sort-icon" />
          </button>
        </span>
        <span class="bookshelf-column-label bookshelf-column-label--author">
          <button
            class="bookshelf-sort-toggle bookshelf-sort-toggle--desktop"
            type="button"
            data-sort-toggle="author"
            data-sort-label="author"
            data-sort-direction="none"
            aria-label="Sort by author."
            aria-pressed="false"
          >
            <span class="bookshelf-sort-label-text">Author</span>
            <AnimatedChevronIcon class="bookshelf-sort-icon" />
          </button>
        </span>
        <span class="bookshelf-column-label bookshelf-column-label--formats">Formats</span>
      </div>
    </div>

    <ScrollFadeFrame class="list-wrap" data-list-wrap initialFade="bottom" tone="subtle">
      <div class="book-list" data-book-grid data-book-list data-scroll-fade-viewport>
        {
          books.map((book, index) => (
            <div class="book-row" data-book-card data-book-id={book.id}>
              <div class="row-cover" style={`--cover-hue:${book.coverHue};`}>
                <ProgressiveImage
                  placeholderClass="row-cover-placeholder"
                  class="row-cover-img"
                  placeholderSrc={book.coverPlaceholderDataUrl}
                  src={book.coverSrc}
                  alt=""
                  width={book.coverWidth}
                  height={book.coverHeight}
                  loading={index < 24 ? "eager" : "lazy"}
                  decoding="async"
                  hidden={!book.coverSrc}
                />
              </div>
              <span class="row-title">{book.title}</span>
              <span class="row-author">
                {splitAuthorSegments(book.author).map((authorSegment) => (
                  <span class="author-token">
                    <button
                      class="author-filter"
                      type="button"
                      aria-label={`Filter bookshelf by ${authorSegment.label}`}
                      data-author-filter={authorSegment.label}
                    >
                      {authorSegment.label}
                    </button>
                    {authorSegment.separator && (
                      <span class="author-separator" aria-hidden="true">
                        {authorSegment.separator}
                      </span>
                    )}
                  </span>
                ))}
              </span>
              <span class="row-formats">
                <MediumTagGroup mediums={book.mediums} />
              </span>
            </div>
          ))
        }
      </div>
    </ScrollFadeFrame>

    <div class="empty-state" data-empty-state hidden>
      <p>No titles match that search.</p>
      <button class="empty-reset" type="button" data-empty-reset>Clear search</button>
    </div>
  </div>

  <p slot="footer-center" class="shelf-count">
    <span data-results-count>{books.length}</span> of {books.length} titles
  </p>

  <script
    id="bookshelf-data"
    type="application/json"
    is:inline
    set:html={JSON.stringify({ books: booksData })}
  />
  <script>
    import "../scripts/bookshelf";
  </script>
</Layout>

<style>
  .bookshelf-page {
    --muted: oklch(96.76% 0.0096 273.36 / 0.45);
    --faint: oklch(96.76% 0.0096 273.36 / 0.28);
    --stroke: oklch(100% 0 0 / 0.06);
    --bookshelf-inline-padding: var(--panel-inline-padding);
    --bookshelf-formats-column-width: 11.2rem;
    --bookshelf-columns: 1.6rem minmax(0, 1fr) minmax(0, 0.55fr)
      var(--bookshelf-formats-column-width);
    --bookshelf-column-gap: 0.65rem;
    --row-divider-inset: calc(1.6rem + 0.65rem);
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .bookshelf-page [hidden] {
    display: none !important;
  }

  .bookshelf-page :is(button, input) {
    font: inherit;
  }

  /* ---- list ---- */

  .bookshelf-header {
    padding: 0 var(--bookshelf-inline-padding) 0.55rem;
  }

  .bookshelf-column-headings {
    display: grid;
    grid-template-columns: var(--bookshelf-columns);
    column-gap: var(--bookshelf-column-gap);
    align-items: center;
    min-width: 0;
    min-height: 2rem;
  }

  .bookshelf-column-label {
    min-width: 0;
    color: var(--faint);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bookshelf-column-label--title-author {
    display: none;
  }

  .bookshelf-sort-toggle {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.28rem;
    min-width: 0;
    margin: -0.14rem -0.18rem;
    padding: 0.14rem 0.18rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    line-height: 1;
    opacity: 0.72;
    text-transform: inherit;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      opacity 180ms ease;
  }

  .bookshelf-sort-toggle:is(:hover, :focus-visible) {
    background: oklch(100% 0 0 / 0.05);
    color: var(--text-primary);
    opacity: 1;
  }

  .bookshelf-sort-toggle:focus-visible {
    outline: none;
    box-shadow: 0 0 0 1px oklch(62.57% 0.0801 278.83 / 0.35);
  }

  .bookshelf-sort-toggle[data-sort-direction="asc"],
  .bookshelf-sort-toggle[data-sort-direction="desc"] {
    color: var(--text-primary);
    opacity: 1;
  }

  .bookshelf-sort-toggle[data-sort-direction="asc"] :global(.animated-chevron-icon) {
    --animated-chevron-scale: 1.05;
    --animated-chevron-up-opacity: 1;
    --animated-chevron-down-opacity: 0;
    --animated-chevron-up-shift: 0px;
    --animated-chevron-down-shift: -2px;
    --animated-chevron-up-dashoffset: 0;
    --animated-chevron-down-dashoffset: 0.18;
  }

  .bookshelf-sort-toggle[data-sort-direction="desc"] :global(.animated-chevron-icon) {
    --animated-chevron-scale: 1.05;
    --animated-chevron-up-opacity: 0;
    --animated-chevron-down-opacity: 1;
    --animated-chevron-up-shift: 2px;
    --animated-chevron-down-shift: 0px;
    --animated-chevron-up-dashoffset: 0.18;
    --animated-chevron-down-dashoffset: 0;
  }

  .bookshelf-sort-label-text {
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bookshelf-sort-icon {
    display: block;
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  :global(.bookshelf-heading-search) {
    --overlay-search-heading-gap: var(--bookshelf-column-gap);
    --overlay-search-heading-trigger-column: 1.6rem;
    grid-column: 1 / 3;
    min-width: 0;
    width: 100%;
    justify-self: stretch;
  }

  :global(.bookshelf-heading-search .overlay-search-heading-meta) {
    color: var(--faint);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bookshelf-column-label--author {
    grid-column: 3;
    display: inline-flex;
    align-items: center;
    justify-self: stretch;
    width: 100%;
  }

  .bookshelf-column-label--formats {
    grid-column: 4;
    justify-self: end;
  }

  .list-wrap {
    flex: 1;
    padding-top: 0;
  }

  .book-list {
    flex: 1;
    display: grid;
    grid-template-columns: var(--bookshelf-columns);
    column-gap: var(--bookshelf-column-gap);
    align-content: start;
    overflow-y: auto;
    min-height: 0;
    scrollbar-width: thin;
    scrollbar-color: oklch(100% 0 0 / 0.08) oklch(0% 0 0 / 0);
    overscroll-behavior: contain;
    padding: 0 var(--bookshelf-inline-padding) 0.45rem;
  }

  .book-row {
    position: relative;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    padding: 0.28rem 0;
    font-size: 0.75rem;
  }

  .book-row:not([hidden]) ~ .book-row:not([hidden])::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--row-divider-inset);
    right: 0;
    height: 1px;
    background: var(--stroke);
  }

  .row-cover {
    position: relative;
    width: 1.6rem;
    height: 2.25rem;
    border-radius: 0.25rem;
    overflow: hidden;
    background: linear-gradient(
      160deg,
      oklch(42% 0.07 var(--cover-hue)),
      oklch(28% 0.045 var(--cover-hue))
    );
    flex-shrink: 0;
  }

  :global(.row-cover .row-cover-placeholder),
  :global(.row-cover .row-cover-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  :global(.row-cover .row-cover-placeholder) {
    transform: scale(1.08);
    filter: blur(10px) saturate(1.08);
  }

  :global(.row-cover .row-cover-img) {
    z-index: 1;
  }

  .row-title {
    color: var(--text-primary);
    font-weight: 500;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-author {
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.12rem;
    min-width: 0;
    line-height: 1.35;
  }

  .author-token {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    white-space: nowrap;
  }

  .author-filter {
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    line-height: inherit;
    margin: -0.08rem -0.22rem;
    padding: 0.08rem 0.22rem;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.16em;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      text-decoration-color 180ms ease;
  }

  .author-filter:is(:hover, :focus-visible) {
    background: oklch(100% 0 0 / 0.07);
    color: var(--text-primary);
    text-decoration-color: currentColor;
  }

  .author-filter:focus-visible {
    outline: none;
  }

  .author-separator {
    color: var(--faint);
    margin: 0 0.18rem;
  }

  .row-formats {
    display: flex;
    justify-content: flex-end;
    justify-self: end;
    flex-shrink: 0;
  }

  /* ---- empty + count ---- */

  .empty-state {
    padding: 1.5rem var(--bookshelf-inline-padding);
    text-align: center;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .empty-reset {
    margin-top: 0.5rem;
    padding: 0.3rem 0.7rem;
    border-radius: 0.45rem;
    border: 1px solid var(--stroke);
    background: oklch(100% 0 0 / 0.04);
    color: var(--muted);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .empty-reset:hover {
    background: oklch(100% 0 0 / 0.08);
  }

  .shelf-count {
    margin: 0;
    color: oklch(96.76% 0.0096 273.36 / 0.28);
    font-size: 0.68rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    opacity: 1;
    transform: none;
  }

  :global(html[data-client-page-swap="true"]) .shelf-count {
    opacity: 0;
    transform: translateY(0.24rem);
    animation: shelf-count-enter 260ms ease 140ms forwards;
  }

  @keyframes shelf-count-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shelf-count {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .author-filter,
    .bookshelf-sort-icon,
    .empty-reset {
      transition: none;
    }
  }

  /* ---- responsive ---- */

  @media (max-width: 760px) {
    .bookshelf-page {
      --bookshelf-columns: 1.6rem minmax(0, 1fr) auto;
      --bookshelf-column-gap: 0.4rem;
      --row-divider-inset: calc(1.6rem + 0.4rem);
    }

    .bookshelf-header {
      padding-top: 0.9rem;
      padding-bottom: 0.45rem;
    }

    .bookshelf-column-headings {
      row-gap: 0.6rem;
    }

    .bookshelf-column-label--title-author {
      grid-column: 2;
      grid-row: 1;
      display: inline-flex;
      align-items: center;
      column-gap: 0.3rem;
      flex-wrap: wrap;
      row-gap: 0.18rem;
    }

    .bookshelf-column-label--author {
      display: none;
    }

    .bookshelf-sort-toggle--desktop {
      display: none;
    }

    .bookshelf-column-label--formats {
      grid-column: 3;
      grid-row: 1;
    }

    :global(.bookshelf-heading-search) {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .book-row {
      grid-template-columns: subgrid;
    }

    .book-list {
      grid-template-columns: var(--bookshelf-columns);
      column-gap: var(--bookshelf-column-gap);
    }

    .row-cover {
      grid-row: 1 / 3;
    }

    .row-author {
      grid-column: 2;
      grid-row: 2;
      font-size: 0.7rem;
    }

    .row-formats {
      grid-row: 1 / 3;
      align-self: center;
    }
  }
</style>

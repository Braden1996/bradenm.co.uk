---
import {
  loadTimelineEntries,
  loadTimelineSlugs,
} from "../../../features/timeline/lib/timeline-data";
import TimelineTemplate from "../../../features/timeline/templates/timeline-template.astro";
import Layout from "../../../layouts/layout.astro";

const pageDescription =
  "Career timeline covering Braden Marshall's education, research, and product engineering roles.";

export async function getStaticPaths() {
  const slugs = await loadTimelineSlugs();

  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const careerEntries = await loadTimelineEntries();

if (careerEntries.length === 0) {
  throw new Error("The career collection is empty.");
}

const selectedEntry = careerEntries.find((entry) => entry.slug === slug);

if (!selectedEntry) {
  throw new Error(`Unknown timeline entry: ${slug ?? "missing slug"}`);
}

const pageTitle = `${selectedEntry.organisation} | Timeline | Braden Marshall`;
---

<Layout title={pageTitle} description={pageDescription} activeTab="timeline">
  {
    selectedEntry.logoSrc && (
      <link
        slot="head"
        rel="preload"
        href={selectedEntry.logoSrc}
        as="image"
        fetchpriority="high"
      />
    )
  }

  <TimelineTemplate
    entries={careerEntries}
    selectedEntry={selectedEntry}
    mobileView="detail"
    backHref="/timeline"
  />
</Layout>

---
import { loadTimelineEntries } from "../features/timeline/lib/timeline-data";
import TimelineTemplate from "../features/timeline/templates/timeline-template.astro";
import Layout from "../layouts/layout.astro";

const pageDescription =
  "Career timeline covering Braden Marshall's education, research, and product engineering roles.";
const careerEntries = await loadTimelineEntries();
const defaultEntry = careerEntries[0];

if (!defaultEntry) {
  throw new Error("The career collection is empty.");
}
---

<Layout title="Timeline | Braden Marshall" description={pageDescription} activeTab="timeline">
  {
    defaultEntry.logoSrc && (
      <link
        slot="head"
        rel="preload"
        href={defaultEntry.logoSrc}
        as="image"
        type="image/webp"
        fetchpriority="high"
      />
    )
  }

  <TimelineTemplate entries={careerEntries} selectedEntry={defaultEntry} mobileView="list" />
</Layout>

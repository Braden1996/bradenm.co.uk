---
import { getCollection, render, type CollectionEntry } from "astro:content";
import careerImages from "../../data/career-images.json";
import ProgressiveImage from "../components/progressive-image.astro";
import ScrollFadeFrame from "../components/scroll-fade-frame.astro";
import TimelineDetailContent from "../components/timeline-detail-content.astro";
import Layout from "../layouts/layout.astro";

const pageDescription =
  "Career timeline covering Braden Marshall's education, research, and product engineering roles.";
const monthLabels = [
  "Jan.",
  "Feb.",
  "Mar.",
  "Apr.",
  "May",
  "Jun.",
  "Jul.",
  "Aug.",
  "Sep.",
  "Oct.",
  "Nov.",
  "Dec.",
];

type CareerEntry = CollectionEntry<"career">;
type ParsedCareerDate = {
  day: number;
  month: number;
  precision: "day" | "month" | "year";
  year: number;
};

function getDaysInMonth(year: number, month: number) {
  return new Date(Date.UTC(year, month, 0)).getUTCDate();
}

function parseCareerDate(value: string): ParsedCareerDate {
  const [yearPart, monthPart, dayPart] = value.split("-");
  const year = Number.parseInt(yearPart, 10);

  if (dayPart) {
    return {
      day: Number.parseInt(dayPart, 10),
      month: Number.parseInt(monthPart, 10),
      precision: "day",
      year,
    };
  }

  if (monthPart) {
    return {
      day: 1,
      month: Number.parseInt(monthPart, 10),
      precision: "month",
      year,
    };
  }

  return {
    day: 1,
    month: 1,
    precision: "year",
    year,
  };
}

function toSortKey(year: number, month: number, day: number) {
  return year * 10_000 + month * 100 + day;
}

function getStartSortKey(value: string) {
  const parsed = parseCareerDate(value);

  return toSortKey(parsed.year, parsed.month, parsed.day);
}

function getEndSortKey(value?: string) {
  if (!value) {
    return Number.POSITIVE_INFINITY;
  }

  const parsed = parseCareerDate(value);

  if (parsed.precision === "year") {
    return toSortKey(parsed.year, 12, 31);
  }

  if (parsed.precision === "month") {
    return toSortKey(parsed.year, parsed.month, getDaysInMonth(parsed.year, parsed.month));
  }

  return toSortKey(parsed.year, parsed.month, parsed.day);
}

function compareSortKeysDescending(left: number, right: number) {
  if (left === right) {
    return 0;
  }

  return left > right ? -1 : 1;
}

function formatCareerDate(value: string) {
  const parsed = parseCareerDate(value);

  if (parsed.precision === "year") {
    return String(parsed.year);
  }

  const monthLabel = monthLabels[parsed.month - 1];

  if (parsed.precision === "month") {
    return `${monthLabel} ${parsed.year}`;
  }

  return `${parsed.day} ${monthLabel} ${parsed.year}`;
}

function formatCareerPeriod(startDate: string, endDate?: string) {
  return `${formatCareerDate(startDate)} - ${endDate ? formatCareerDate(endDate) : "Present"}`;
}

function compareCareerEntries(left: CareerEntry, right: CareerEntry) {
  const startDifference = compareSortKeysDescending(
    left.data.startDate ? getStartSortKey(left.data.startDate) : 0,
    right.data.startDate ? getStartSortKey(right.data.startDate) : 0,
  );

  if (startDifference !== 0) {
    return startDifference;
  }

  const endDifference = compareSortKeysDescending(
    getEndSortKey(left.data.endDate),
    getEndSortKey(right.data.endDate),
  );

  if (endDifference !== 0) {
    return endDifference;
  }

  return left.id.localeCompare(right.id);
}

const careerImageMap =
  (
    careerImages as {
      images?: Record<
        string,
        {
          height?: number;
          placeholderDataUrl?: string;
          thumbhash?: string;
          width?: number;
        }
      >;
    }
  ).images ?? {};
const careerCollection = (await getCollection("career")).sort(compareCareerEntries);
const careerEntries = await Promise.all(
  careerCollection.map(async (entry: CareerEntry) => {
    const { Content } = await render(entry);

    return {
      Content,
      location: entry.data.location,
      logoHeight: entry.data.logoSrc ? (careerImageMap[entry.data.logoSrc]?.height ?? 0) : 0,
      logoPlaceholderDataUrl: entry.data.logoSrc
        ? (careerImageMap[entry.data.logoSrc]?.placeholderDataUrl ?? "")
        : "",
      logoSrc: entry.data.logoSrc,
      logoWidth: entry.data.logoSrc ? (careerImageMap[entry.data.logoSrc]?.width ?? 0) : 0,
      mark: entry.data.mark,
      organisation: entry.data.organisation,
      period: formatCareerPeriod(entry.data.startDate, entry.data.endDate),
      slug: entry.id,
      title: entry.data.title,
    };
  }),
);

if (careerEntries.length === 0) {
  throw new Error("The career collection is empty.");
}

const defaultEntry = careerEntries[0];
const requestedSlug = Astro.url.searchParams.get("item");
const initialEntry = careerEntries.find((entry) => entry.slug === requestedSlug) ?? defaultEntry;
---

<Layout title="Timeline | Braden Marshall" description={pageDescription} activeTab="timeline">
  {
    initialEntry.logoSrc && (
      <link slot="head" rel="preload" href={initialEntry.logoSrc} as="image" fetchpriority="high" />
    )
  }
  <div
    class="timeline-page"
    data-timeline-page
    data-active-slug={initialEntry.slug}
    data-has-selection={requestedSlug ? "" : undefined}
  >
    <div class="timeline-layout">
      <aside class="timeline-nav" transition:persist aria-label="Career timeline">
        <ScrollFadeFrame class="timeline-nav-frame" initialFade="bottom" tone="subtle">
          <ol class="timeline-list" data-scroll-fade-viewport>
            {
              careerEntries.map((entry) => (
                <li
                  class="timeline-entry"
                  data-selected={entry.slug === initialEntry.slug ? "true" : "false"}
                >
                  <a
                    href={`/timeline?item=${entry.slug}`}
                    class="timeline-link"
                    data-timeline-link
                    data-entry-slug={entry.slug}
                    data-selected={entry.slug === initialEntry.slug ? "true" : "false"}
                    aria-current={entry.slug === initialEntry.slug ? "page" : undefined}
                  >
                    <span class="timeline-marker">
                      <span class="timeline-logo-shell">
                        {entry.logoSrc ? (
                          <ProgressiveImage
                            placeholderClass="timeline-logo-placeholder"
                            placeholderSrc={entry.logoPlaceholderDataUrl}
                            class="timeline-logo"
                            src={entry.logoSrc}
                            alt={`${entry.organisation} logo`}
                            width={entry.logoWidth}
                            height={entry.logoHeight}
                            loading="eager"
                            decoding="sync"
                            fetchpriority="high"
                          />
                        ) : (
                          <span class="timeline-fallback" aria-hidden="true">
                            {entry.mark}
                          </span>
                        )}
                      </span>
                    </span>

                    <span class="timeline-copy">
                      <span class="timeline-organisation">{entry.organisation}</span>
                      <span class="timeline-role">{entry.title}</span>
                      <span class="timeline-meta">
                        {entry.period}
                        <span class="timeline-meta-separator" aria-hidden="true">
                          /
                        </span>
                        {entry.location}
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </ScrollFadeFrame>
      </aside>

      <section class="timeline-detail">
        <a href="/timeline" class="timeline-back-link">Close</a>
        <div class="timeline-detail-inner">
          <TimelineDetailContent entry={initialEntry} />
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  function syncPersistedNav() {
    const page = document.querySelector<HTMLElement>("[data-timeline-page]");
    const nav = document.querySelector("[data-timeline-nav]");

    if (!page || !nav) {
      return;
    }

    const activeSlug = page.dataset.activeSlug ?? "";

    for (const link of nav.querySelectorAll<HTMLElement>("[data-timeline-link]")) {
      const entry = link.closest<HTMLElement>(".timeline-entry");
      const isSelected = link.dataset.entrySlug === activeSlug;

      link.dataset.selected = String(isSelected);

      if (entry) {
        entry.dataset.selected = String(isSelected);
      }

      if (isSelected) {
        link.setAttribute("aria-current", "page");
        link.scrollIntoView({ block: "nearest" });
      } else {
        link.removeAttribute("aria-current");
      }
    }
  }

  document.addEventListener("astro:after-swap", syncPersistedNav);
</script>

<style>
  .timeline-page {
    --timeline-accent: #bd93f9;
    flex: 1 1 auto;
    display: flex;
    position: relative;
    min-height: 0;
  }

  .timeline-layout {
    flex: 1 1 auto;
    display: flex;
    align-items: stretch;
    gap: 1.4rem;
    min-height: 0;
    padding: 0 0 1.45rem var(--panel-inline-padding);
    overflow: hidden;
  }

  .timeline-nav,
  .timeline-detail {
    min-height: 0;
  }

  .timeline-nav {
    flex: 0 0 clamp(18rem, 31vw, 23rem);
    display: flex;
    min-width: 0;
    position: relative;
    padding-right: 1.1rem;
    border-right: 1px solid oklch(100% 0 0 / 0.06);
    overflow: hidden;
  }

  .timeline-nav-frame {
    flex: 1 1 auto;
    min-height: 0;
  }

  .timeline-list {
    --timeline-entry-gap: 0.2rem;
    --timeline-line-left: 1.36rem;
    --timeline-line-width: 2px;
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--timeline-entry-gap);
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: oklch(100% 0 0 / 0.08) oklch(0% 0 0 / 0);
    padding-right: 0.15rem;
    padding-bottom: 0.35rem;
  }

  .timeline-entry {
    position: relative;
  }

  .timeline-entry::before,
  .timeline-entry::after {
    content: "";
    position: absolute;
    left: calc(var(--timeline-line-left) - (var(--timeline-line-width) / 2));
    width: var(--timeline-line-width);
    background: oklch(100% 0 0 / 0.14);
  }

  .timeline-entry::before {
    top: calc(var(--timeline-entry-gap) * -0.5);
    bottom: 50%;
  }

  .timeline-entry::after {
    top: 50%;
    bottom: calc(var(--timeline-entry-gap) * -0.5);
  }

  .timeline-entry[data-selected="true"]::after,
  .timeline-entry[data-selected="true"] ~ .timeline-entry::before,
  .timeline-entry[data-selected="true"] ~ .timeline-entry::after {
    background: var(--timeline-accent);
  }

  .timeline-entry:first-child::before,
  .timeline-entry:last-child::after {
    display: none;
  }

  .timeline-link {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 0.52rem 0.58rem 0.52rem 0;
    text-decoration: none;
    transition:
      opacity 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .timeline-marker {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-logo-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.08rem;
    border-radius: 0.9rem;
    background: oklch(19.1% 0.015 268.5);
    border: 1px solid oklch(100% 0 0 / 0.07);
    box-shadow: 0 0 0 1px oklch(0% 0 0 / 0.16);
    overflow: hidden;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      opacity 180ms ease;
  }

  :global(.timeline-logo-shell .timeline-logo),
  :global(.timeline-logo-shell .timeline-logo-placeholder),
  .timeline-fallback {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 0.72rem;
  }

  :global(.timeline-logo-shell .timeline-logo-placeholder) {
    transform: scale(1.04);
    filter: blur(5px) saturate(1.08) contrast(1.04);
  }

  :global(.timeline-logo-shell .timeline-logo) {
    object-fit: contain;
    position: relative;
    z-index: 1;
  }

  .timeline-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: oklch(100% 0 0 / 0.04);
    color: var(--text-primary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .timeline-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.16rem;
  }

  .timeline-organisation {
    color: var(--text-primary);
    font-size: 0.88rem;
    line-height: 1.3;
    font-weight: 600;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .timeline-role {
    color: oklch(96.76% 0.0096 273.36 / 0.54);
    font-size: 0.74rem;
    line-height: 1.45;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .timeline-meta {
    color: oklch(96.76% 0.0096 273.36 / 0.38);
    font-size: 0.7rem;
    line-height: 1.45;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .timeline-meta-separator {
    margin: 0 0.35rem;
    color: oklch(96.76% 0.0096 273.36 / 0.22);
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-logo-shell {
    opacity: 0.58;
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-logo,
  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-fallback {
    opacity: 0.68;
  }

  .timeline-entry[data-selected="true"] ~ .timeline-entry .timeline-logo-shell {
    border-color: color-mix(in srgb, var(--timeline-accent) 36%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--timeline-accent) 24%, transparent);
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-organisation {
    color: oklch(96.76% 0.0096 273.36 / 0.66);
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-role {
    color: oklch(96.76% 0.0096 273.36 / 0.4);
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-meta {
    color: oklch(96.76% 0.0096 273.36 / 0.28);
  }

  .timeline-link[data-selected="true"] .timeline-logo-shell {
    border-color: color-mix(in srgb, var(--timeline-accent) 52%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--timeline-accent) 40%, transparent),
      0 0 0 0.24rem color-mix(in srgb, var(--timeline-accent) 10%, transparent);
  }

  .timeline-link[data-selected="true"] .timeline-organisation {
    color: var(--timeline-accent);
  }

  .timeline-link[data-selected="true"] .timeline-role {
    color: oklch(96.76% 0.0096 273.36 / 0.78);
  }

  .timeline-link[data-selected="true"] .timeline-meta {
    color: oklch(96.76% 0.0096 273.36 / 0.56);
  }

  .timeline-detail {
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .timeline-back-link {
    display: none;
  }

  .timeline-detail-inner {
    display: flex;
    min-height: 0;
    height: 100%;
    padding: 0.6rem 0 0.2rem 0.1rem;
  }

  .timeline-detail-inner :global(.timeline-detail-content) {
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
  }

  .timeline-detail-inner :global(.timeline-detail-body-frame) {
    height: 100%;
    min-height: 0;
  }

  .timeline-detail-inner :global(.timeline-detail-body) {
    min-height: 0;
  }

  @media (max-width: 760px) {
    .timeline-layout {
      display: flex;
      flex-direction: column;
      padding: 0 var(--panel-inline-padding) 1.1rem;
      overflow: visible;
    }

    .timeline-nav {
      flex: 1 1 auto;
      padding-right: 0;
      border-right: none;
      overflow: visible;
    }

    .timeline-nav-frame {
      min-height: auto;
    }

    .timeline-detail {
      display: none;
    }

    .timeline-page[data-has-selection] .timeline-nav {
      display: none;
    }

    .timeline-page[data-has-selection] .timeline-detail {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
    }

    .timeline-page[data-has-selection] .timeline-back-link {
      display: block;
      align-self: flex-end;
      margin: 0 0 0.45rem 0;
      padding: 0.32rem 0.72rem;
      border: 1px solid oklch(100% 0 0 / 0.08);
      border-radius: 999px;
      background: oklch(100% 0 0 / 0.04);
      color: oklch(96.76% 0.0096 273.36 / 0.66);
      font-size: 0.72rem;
      line-height: 1;
      text-decoration: none;
      flex-shrink: 0;
    }

    .timeline-page[data-has-selection] .timeline-detail-inner {
      flex: 1 1 auto;
      padding: 0;
    }

    .timeline-page[data-has-selection] .timeline-detail-inner :global(.timeline-detail-body) {
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    .timeline-page[data-has-selection] .timeline-detail-inner :global(.timeline-detail-copy) {
      padding-right: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-link {
      transition: none;
    }

    .timeline-logo-shell,
    .timeline-organisation,
    .timeline-role,
    .timeline-meta {
      transition: none;
    }
  }
</style>

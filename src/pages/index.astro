---
import ScrollFadeFrame from "../components/scroll-fade-frame.astro";
import Layout from "../layouts/layout.astro";

const pageDescription =
  "Engineering lead building cross-platform product experiences across mobile, desktop, and web.";
---

<Layout title="Braden Marshall" description={pageDescription} activeTab="about">
  <div class="about-page">
    <ScrollFadeFrame class="about-frame">
      <div class="about-scroll" data-scroll-fade-viewport>
        <section class="about section">
          <p class="eyebrow">About</p>
          <h1 class="intro">
            Engineering Lead at Attio, building the world&apos;s most beautiful and powerful CRM.
          </h1>
          <p class="summary">
            I joined as a founding product engineer and helped scale the company from pre-launch to
            a $52 million Series B. I now lead the Companion Apps team across mobile, desktop, and
            browser extension products.
          </p>
          <p class="summary">
            Before Attio, I worked at Thought Machine, Theodo UK, and Cardiff University.
          </p>
          <a class="timeline-link" href="/timeline">Open full timeline</a>
        </section>
      </div>
    </ScrollFadeFrame>
  </div>
</Layout>

<style>
  .about-page {
    flex: 1;
    min-height: 0;
  }

  .about-frame {
    flex: 1;
    min-height: 0;
  }

  .about-scroll {
    display: flex;
    align-items: center;
    height: 100%;
    overflow: auto;
    padding: 1.5rem var(--panel-inline-padding);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .about {
    max-width: 36rem;
    padding: 0.35rem 0 0.85rem;
  }

  .eyebrow {
    color: oklch(96.76% 0.0096 273.36 / 0.44);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .intro {
    color: var(--text-primary);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    text-wrap: balance;
  }

  .summary {
    color: oklch(96.76% 0.0096 273.36 / 0.68);
    font-size: 0.92rem;
    line-height: 1.72;
  }

  .timeline-link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-top: 0.35rem;
    padding: 0.48rem 0.82rem;
    border: 1px solid oklch(100% 0 0 / 0.08);
    border-radius: 999px;
    background: oklch(100% 0 0 / 0.04);
    color: var(--text-primary);
    font-size: 0.74rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .timeline-link:hover {
    border-color: oklch(100% 0 0 / 0.14);
    background: oklch(100% 0 0 / 0.06);
    color: oklch(100% 0 0 / 0.96);
  }

  @media (max-width: 760px) {
    .about-scroll {
      align-items: flex-start;
      padding-top: 1.2rem;
    }

    .intro {
      text-wrap: pretty;
    }
  }
</style>

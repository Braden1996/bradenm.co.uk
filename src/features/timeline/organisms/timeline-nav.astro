---
import ScrollFadeFrame from "../../../components/molecules/scroll-fade-frame.astro";
import type { TimelineEntryViewModel } from "../lib/timeline-view-model";
import TimelineNavItem from "../molecules/timeline-nav-item.astro";

interface Props {
  activeSlug: string;
  entries: TimelineEntryViewModel[];
}

const { entries, activeSlug } = Astro.props;
---

<aside class="timeline-nav" data-timeline-nav transition:persist aria-label="Career timeline">
  <ScrollFadeFrame class="timeline-nav-frame" initialFade="bottom" tone="subtle">
    <ol class="timeline-list" data-scroll-fade-viewport>
      {entries.map((entry) => <TimelineNavItem entry={entry} selectedSlug={activeSlug} />)}
    </ol>
  </ScrollFadeFrame>
</aside>

<style>
  .timeline-nav {
    flex: 0 0 clamp(18rem, 31vw, 23rem);
    display: flex;
    min-width: 0;
    min-height: 0;
    position: relative;
    padding-right: 1.1rem;
    border-right: 1px solid var(--color-border-soft);
    overflow: hidden;
  }

  .timeline-nav-frame {
    flex: 1 1 auto;
    min-height: 0;
  }

  .timeline-list {
    --timeline-entry-gap: 0.2rem;
    --timeline-line-left: 1.36rem;
    --timeline-line-width: 2px;
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--timeline-entry-gap);
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
    padding-right: 0.15rem;
    padding-bottom: 0.35rem;
  }

  @media (max-width: 760px) {
    .timeline-nav {
      flex: 1 1 auto;
      padding-right: 0;
      border-right: none;
      overflow: visible;
    }

    .timeline-nav-frame {
      min-height: auto;
    }
  }
</style>

---
import ProgressiveImage from "../../../components/atoms/progressive-image.astro";
import type { TimelineEntryViewModel } from "../lib/timeline-view-model";

interface Props {
  entry: TimelineEntryViewModel;
  selectedSlug: string;
}

const { entry, selectedSlug } = Astro.props;
const isSelected = entry.slug === selectedSlug;
---

<li class="timeline-entry" data-selected={String(isSelected)}>
  <a
    href={`/timeline/${entry.slug}`}
    class="timeline-link"
    data-timeline-link
    data-entry-slug={entry.slug}
    data-selected={String(isSelected)}
    aria-current={isSelected ? "page" : undefined}
  >
    <span class="timeline-marker">
      <span class="timeline-logo-shell">
        {
          entry.logoSrc ? (
            <ProgressiveImage
              placeholderClass="timeline-logo-placeholder"
              placeholderSrc={entry.logoPlaceholderDataUrl}
              class="timeline-logo"
              src={entry.logoSrc}
              alt={`${entry.organisation} logo`}
              width={entry.logoWidth}
              height={entry.logoHeight}
              loading="eager"
              decoding="sync"
              fetchpriority="high"
            />
          ) : (
            <span class="timeline-fallback" aria-hidden="true">
              {entry.mark}
            </span>
          )
        }
      </span>
    </span>

    <span class="timeline-copy">
      <span class="timeline-organisation">{entry.organisation}</span>
      <span class="timeline-role">{entry.title}</span>
      <span class="timeline-meta">
        {entry.period}
        <span class="timeline-meta-separator" aria-hidden="true"> / </span>
        {entry.location}
      </span>
    </span>
  </a>
</li>

<style>
  .timeline-entry {
    position: relative;
  }

  .timeline-entry::before,
  .timeline-entry::after {
    content: "";
    position: absolute;
    left: calc(var(--timeline-line-left) - (var(--timeline-line-width) / 2));
    width: var(--timeline-line-width);
    background: var(--color-border-strong);
  }

  .timeline-entry::before {
    top: calc(var(--timeline-entry-gap) * -0.5);
    bottom: 50%;
  }

  .timeline-entry::after {
    top: 50%;
    bottom: calc(var(--timeline-entry-gap) * -0.5);
  }

  .timeline-entry[data-selected="true"]::after,
  .timeline-entry[data-selected="true"] ~ .timeline-entry::before,
  .timeline-entry[data-selected="true"] ~ .timeline-entry::after {
    background: var(--color-accent);
  }

  .timeline-entry:first-child::before,
  .timeline-entry:last-child::after {
    display: none;
  }

  .timeline-link {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 0.52rem 0.58rem 0.52rem 0;
    text-decoration: none;
    transition:
      opacity 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .timeline-marker {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-logo-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.08rem;
    border-radius: 0.9rem;
    background: var(--color-surface-panel);
    border: 1px solid var(--color-border-soft);
    box-shadow: 0 0 0 1px var(--color-shadow-outline);
    overflow: hidden;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      opacity 180ms ease;
  }

  .timeline-logo-shell :global(.timeline-logo),
  .timeline-logo-shell :global(.timeline-logo-placeholder),
  .timeline-fallback {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 0.72rem;
  }

  .timeline-logo-shell :global(.timeline-logo-placeholder) {
    transform: scale(1.04);
    filter: blur(5px) saturate(1.08) contrast(1.04);
  }

  .timeline-logo-shell :global(.timeline-logo) {
    object-fit: contain;
    position: relative;
    z-index: 1;
  }

  .timeline-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-subtle);
    color: var(--color-text-primary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .timeline-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.16rem;
  }

  .timeline-organisation {
    color: var(--color-text-primary);
    font-size: 0.88rem;
    line-height: 1.3;
    font-weight: 600;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .timeline-role {
    color: color-mix(in srgb, var(--color-text-primary) 56%, transparent);
    font-size: 0.74rem;
    line-height: 1.45;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .timeline-meta {
    color: var(--color-text-faint);
    font-size: 0.7rem;
    line-height: 1.45;
    transition:
      color 180ms ease,
      opacity 180ms ease;
  }

  .timeline-meta-separator {
    margin: 0 0.35rem;
    color: color-mix(in srgb, var(--color-text-faint) 65%, transparent);
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-logo-shell {
    opacity: 0.58;
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) :global(.timeline-logo),
  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-fallback {
    opacity: 0.68;
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-logo-shell {
    border-color: color-mix(in srgb, var(--color-accent) 36%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-accent) 24%, transparent);
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-organisation {
    color: color-mix(in srgb, var(--color-text-primary) 72%, transparent);
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-role {
    color: color-mix(in srgb, var(--color-text-primary) 42%, transparent);
  }

  .timeline-entry:has(~ .timeline-entry[data-selected="true"]) .timeline-meta {
    color: color-mix(in srgb, var(--color-text-faint) 74%, transparent);
  }

  .timeline-link[data-selected="true"] .timeline-logo-shell {
    border-color: color-mix(in srgb, var(--color-accent) 52%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-accent) 40%, transparent),
      0 0 0 0.24rem color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .timeline-link[data-selected="true"] .timeline-organisation {
    color: var(--color-accent);
  }

  .timeline-link[data-selected="true"] .timeline-role {
    color: color-mix(in srgb, var(--color-text-primary) 80%, transparent);
  }

  .timeline-link[data-selected="true"] .timeline-meta {
    color: color-mix(in srgb, var(--color-text-primary) 58%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-link,
    .timeline-logo-shell,
    .timeline-organisation,
    .timeline-role,
    .timeline-meta {
      transition: none;
    }
  }
</style>

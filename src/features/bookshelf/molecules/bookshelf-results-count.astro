---
import { formatBookshelfResultsCount } from "../lib/bookshelf-data";

interface Props {
  instanceId?: string;
  total: number;
}

const { instanceId, total } = Astro.props;
const label = formatBookshelfResultsCount(total, total, false);
---

<p
  class="shelf-count"
  aria-atomic="true"
  aria-live="polite"
  data-bookshelf-results-for={instanceId}
  data-results-count
  data-results-total={total}
>
  {label}
</p>

<style>
  /* Announce filtering without adding a visible footer or taking any shelf space. */
  .shelf-count {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    border: 0;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

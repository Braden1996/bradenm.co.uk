---
import Chip from "../../../components/atoms/chip.astro";
import ProgressiveImage from "../../../components/atoms/progressive-image.astro";
import TagGroup from "../../../components/molecules/tag-group.astro";
import type { BookViewModel } from "../lib/bookshelf-data";

interface Props {
  book: BookViewModel;
  eager?: boolean;
}

const { book, eager = false } = Astro.props;
---

<div class="book-row" data-book-card data-book-id={book.id}>
  <div class="row-cover" style={`--cover-hue:${book.coverHue};`}>
    <ProgressiveImage
      class="row-cover-image"
      src={book.coverSrc}
      alt=""
      width={book.coverWidth}
      height={book.coverHeight}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      hidden={!book.coverSrc}
    />
  </div>
  <span class="row-title">{book.title}</span>
  <span class="row-author">
    {
      book.authorSegments.map((authorSegment) => (
        <span class="author-token">
          <Chip
            as="button"
            class="author-filter"
            interactive
            type="button"
            aria-label={`Filter bookshelf by ${authorSegment.label}`}
            data-author-filter={authorSegment.label}
          >
            {authorSegment.label}
          </Chip>
          {authorSegment.separator && (
            <span class="author-separator" aria-hidden="true">
              {authorSegment.separator}
            </span>
          )}
        </span>
      ))
    }
  </span>
  <span class="row-formats">
    <TagGroup items={book.mediumTags} />
  </span>
</div>

<style>
  .book-row {
    position: relative;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    padding: 0.28rem 0;
    font-size: 0.75rem;
  }

  .book-row[hidden] {
    display: none !important;
  }

  .book-row:not([hidden]) ~ .book-row:not([hidden])::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--row-divider-inset);
    right: 0;
    height: 1px;
    background: var(--bookshelf-stroke);
  }

  .row-cover {
    position: relative;
    width: 1.6rem;
    height: 2.25rem;
    border-radius: 0.25rem;
    overflow: hidden;
    background: linear-gradient(
      160deg,
      oklch(42% 0.07 var(--cover-hue)),
      oklch(28% 0.045 var(--cover-hue))
    );
    flex-shrink: 0;
  }

  .row-cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    --progressive-image-fit: cover;
  }

  .row-title {
    color: var(--color-text-primary);
    font-weight: 500;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-author {
    color: var(--bookshelf-text-muted);
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.12rem;
    min-width: 0;
    line-height: 1.35;
  }

  .author-token {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    white-space: nowrap;
  }

  .author-filter {
    --chip-padding-block: 0.11rem;
    --chip-padding-inline: 0.36rem;
    --chip-gap: 0;
    --chip-background-hover: var(--palette-white-05);
    --chip-background-active: var(--palette-white-05);
    --chip-background-active-hover: var(--palette-white-06);
  }

  .author-separator {
    color: var(--bookshelf-text-faint);
    margin: 0 0.18rem;
  }

  .row-formats {
    display: flex;
    justify-content: flex-end;
    justify-self: end;
    flex-shrink: 0;
  }

  @media (max-width: 760px) {
    .row-cover {
      grid-row: 1 / 3;
    }

    .row-author {
      grid-column: 2;
      grid-row: 2;
      font-size: 0.7rem;
    }

    .row-formats {
      grid-row: 1 / 3;
      align-self: center;
    }
  }
</style>

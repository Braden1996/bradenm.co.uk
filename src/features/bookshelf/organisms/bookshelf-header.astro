---
import AnimatedChevronIcon from "../../../components/atoms/animated-chevron-icon.astro";
import Chip from "../../../components/atoms/chip.astro";
import OverlaySearchBar from "../../../components/molecules/overlay-search-bar.astro";

interface Props {
  searchId?: string;
}

const { searchId = "bookshelf-search" } = Astro.props;
---

<div class="bookshelf-header">
  <div class="bookshelf-column-headings">
    <div class="bookshelf-heading-search">
      <OverlaySearchBar
        id={searchId}
        label="Search the shelf"
        mode="heading"
        placeholder="Search titles or authors"
      >
        <Chip
          as="button"
          slot="heading-meta"
          class="bookshelf-sort-toggle bookshelf-sort-toggle--desktop"
          interactive
          type="button"
          data-sort-toggle="title"
          data-sort-label="title"
          data-sort-direction="asc"
          aria-label="Sort by title. Currently ascending."
          aria-pressed="true"
        >
          <span class="bookshelf-sort-label-text">Title</span>
          <AnimatedChevronIcon slot="endSymbol" class="bookshelf-sort-icon" />
        </Chip>
      </OverlaySearchBar>
    </div>

    <span class="bookshelf-column-label bookshelf-column-label--title-author">
      <Chip
        as="button"
        class="bookshelf-sort-toggle bookshelf-sort-toggle--mobile"
        interactive
        type="button"
        data-sort-toggle="title"
        data-sort-label="title"
        data-sort-direction="asc"
        aria-label="Sort by title. Currently ascending."
        aria-pressed="true"
      >
        <span class="bookshelf-sort-label-text">Title</span>
        <AnimatedChevronIcon slot="endSymbol" class="bookshelf-sort-icon" />
      </Chip>
      <Chip
        as="button"
        class="bookshelf-sort-toggle bookshelf-sort-toggle--mobile"
        interactive
        type="button"
        data-sort-toggle="author"
        data-sort-label="author"
        data-sort-direction="none"
        aria-label="Sort by author."
        aria-pressed="false"
      >
        <span class="bookshelf-sort-label-text">Author</span>
        <AnimatedChevronIcon slot="endSymbol" class="bookshelf-sort-icon" />
      </Chip>
    </span>

    <span class="bookshelf-column-label bookshelf-column-label--author">
      <Chip
        as="button"
        class="bookshelf-sort-toggle bookshelf-sort-toggle--desktop"
        interactive
        type="button"
        data-sort-toggle="author"
        data-sort-label="author"
        data-sort-direction="none"
        aria-label="Sort by author."
        aria-pressed="false"
      >
        <span class="bookshelf-sort-label-text">Author</span>
        <AnimatedChevronIcon slot="endSymbol" class="bookshelf-sort-icon" />
      </Chip>
    </span>

    <span class="bookshelf-column-label bookshelf-column-label--formats">Formats</span>
  </div>
</div>

<style>
  .bookshelf-header {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 0 var(--bookshelf-inline-padding) 0.55rem;
    background: var(--surface-panel-background);
  }

  .bookshelf-column-headings {
    display: grid;
    grid-template-columns: var(--bookshelf-columns);
    column-gap: var(--bookshelf-column-gap);
    align-items: center;
    min-width: 0;
    min-height: 2rem;
  }

  .bookshelf-column-label {
    min-width: 0;
    color: var(--bookshelf-text-faint);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bookshelf-column-label--title-author {
    display: none;
  }

  .bookshelf-sort-toggle {
    --chip-padding-block: 0.18rem;
    --chip-padding-inline-base: 0.42rem;
    --chip-padding-inline-symbol: 0.26rem;
    --chip-gap: 0.24rem;
    --chip-background-hover: var(--palette-white-05);
    --chip-background-active: var(--palette-white-06);
    --chip-background-active-hover: var(--palette-white-07);
    color: var(--bookshelf-text-muted);
    line-height: 1;
    opacity: 1;
  }

  .bookshelf-sort-toggle[data-sort-direction="asc"] {
    --animated-chevron-scale: 1.05;
    --animated-chevron-up-opacity: 1;
    --animated-chevron-down-opacity: 0;
    --animated-chevron-up-shift: 0px;
    --animated-chevron-down-shift: -2px;
    --animated-chevron-up-dashoffset: 0;
    --animated-chevron-down-dashoffset: 0.18;
  }

  .bookshelf-sort-toggle[data-sort-direction="desc"] {
    --animated-chevron-scale: 1.05;
    --animated-chevron-up-opacity: 0;
    --animated-chevron-down-opacity: 1;
    --animated-chevron-up-shift: 2px;
    --animated-chevron-down-shift: 0px;
    --animated-chevron-up-dashoffset: 0.18;
    --animated-chevron-down-dashoffset: 0;
  }

  .bookshelf-sort-label-text {
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bookshelf-sort-icon {
    display: block;
    flex: none;
  }

  .bookshelf-heading-search {
    --overlay-search-heading-gap: var(--bookshelf-column-gap);
    --overlay-search-heading-trigger-column: 1.6rem;
    --overlay-search-heading-meta-color: var(--bookshelf-text-faint);
    --overlay-search-heading-meta-font-size: 0.62rem;
    --overlay-search-heading-meta-font-weight: 600;
    --overlay-search-heading-meta-letter-spacing: 0.08em;
    --overlay-search-heading-meta-line-height: 1;
    --overlay-search-heading-meta-text-transform: uppercase;
    --overlay-search-heading-meta-white-space: nowrap;
    grid-column: 1 / 3;
    min-width: 0;
    width: 100%;
    justify-self: stretch;
  }

  .bookshelf-heading-search > :first-child {
    width: 100%;
  }

  .bookshelf-column-label--author {
    grid-column: 3;
    display: inline-flex;
    align-items: center;
    justify-self: stretch;
    width: 100%;
  }

  .bookshelf-column-label--formats {
    grid-column: 4;
    justify-self: end;
  }

  @media (max-width: 760px) {
    .bookshelf-header {
      padding-top: 0.9rem;
      padding-bottom: 0.45rem;
    }

    .bookshelf-column-headings {
      row-gap: 0.6rem;
    }

    .bookshelf-column-label--title-author {
      grid-column: 2;
      grid-row: 1;
      display: inline-flex;
      align-items: center;
      column-gap: 0.3rem;
      flex-wrap: wrap;
      row-gap: 0.18rem;
    }

    .bookshelf-column-label--author {
      display: none;
    }

    .bookshelf-sort-toggle--desktop {
      display: none;
    }

    .bookshelf-column-label--formats {
      grid-column: 3;
      grid-row: 1;
    }

    .bookshelf-heading-search {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>

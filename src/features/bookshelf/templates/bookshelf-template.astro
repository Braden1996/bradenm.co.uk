---
import type { BookViewModel } from "../lib/bookshelf-data";
import BookshelfCase from "../organisms/bookshelf-case.astro";
import BookshelfEmptyState from "../organisms/bookshelf-empty-state.astro";
import "../styles/book-atlas.css";

interface Props {
  books: BookViewModel[];
  eagerCoverCount?: number;
  instanceId?: string;
  payloadJson?: string;
}

const { books, eagerCoverCount = 6, instanceId = "bookshelf", payloadJson } = Astro.props;
---

<div
  class="bookshelf-page"
  data-bookshelf-page
  data-bookshelf-root
  data-bookshelf-instance={instanceId}
>
  <BookshelfCase books={books} eagerCoverCount={eagerCoverCount} instanceId={instanceId} />
  <BookshelfEmptyState />
  {
    payloadJson && (
      <script type="application/json" data-bookshelf-payload is:inline set:html={payloadJson} />
    )
  }
</div>

<style>
  .bookshelf-page {
    --bookshelf-text-muted: var(--color-text-muted);
    --bookshelf-text-faint: var(--color-text-faint);
    --bookshelf-stroke: var(--color-border-soft);
    --bookshelf-inline-padding: var(--panel-gutter);
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    min-height: auto;
  }

  .bookshelf-page [hidden] {
    display: none !important;
  }

  .bookshelf-page :is(button, input) {
    font: inherit;
  }
</style>

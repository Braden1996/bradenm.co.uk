---
import type { AboutRoom } from "../lib/about-room";

interface Props {
  room?: AboutRoom;
}

const { room = "letter" } = Astro.props;
---

<div class="about-template">
  <!-- The route supplies only its own room and feature CSS. The other room
       retains a real URL and is fetched on intent, then cached in this sheet. -->
  <div class="about-template__stage" data-room={room} data-about-rooms>
    <div class="about-template__scene" data-room-scene>
      <slot />
    </div>
  </div>
</div>

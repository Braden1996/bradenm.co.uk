---
import { ClientRouter } from "astro:transitions";
import FooterSocialLinks from "../components/footer-social-links.astro";
import ProgressiveImage from "../components/progressive-image.astro";
import SiteTabs from "../components/site-tabs.astro";
import profileImage from "../../data/profile-image.json";

interface Props {
  title: string;
  description: string;
  activeTab?: "about" | "timeline" | "bookshelf";
}

type ProfileImage = {
  height: number;
  placeholderDataUrl?: string;
  placeholderSrc?: string;
  src: string;
  thumbhash: string;
  width: number;
};

const { title, description, activeTab = "about" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const headerProfileImage = profileImage as ProfileImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link
      rel="preload"
      href="/fonts/brutal-type-bold.fontimize-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/fonts/inter-regular.subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={headerProfileImage.src} as="image" fetchpriority="high" />
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="page-wrap">
      <div
        class:list={[
          "panel",
          activeTab === "bookshelf" && "panel--bookshelf",
          activeTab === "timeline" && "panel--timeline",
        ]}
        data-panel
      >
        <header class="panel-header">
          <div class="header-identity">
            <div class="header-avatar-shell" transition:persist>
              <ProgressiveImage
                placeholderClass="header-avatar-placeholder"
                class="header-avatar"
                placeholderSrc={headerProfileImage.placeholderDataUrl ??
                  headerProfileImage.placeholderSrc}
                src={headerProfileImage.src}
                alt="Portrait of Braden Marshall"
                width={headerProfileImage.width}
                height={headerProfileImage.height}
                loading="eager"
                decoding="sync"
                fetchpriority="high"
              />
            </div>
            <div class="header-copy">
              <span class="header-name">Braden Marshall</span>
              <span class="header-role">Senior Software Engineer</span>
            </div>
          </div>
          <div>
            <SiteTabs activeTab={activeTab} />
          </div>
        </header>
        <div class="panel-body">
          <main class="panel-main">
            <slot />
          </main>
          <footer class="panel-footer">
            <div class="panel-footer-center">
              <slot name="footer-center" />
            </div>
            <div class="panel-footer-social">
              <FooterSocialLinks />
            </div>
          </footer>
        </div>
      </div>
    </div>
    <script>
      import "../scripts/panel-transition";
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  @font-face {
    font-family: "BrutalType";
    src: url("/fonts/brutal-type-bold.fontimize-subset.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: block;
  }

  @font-face {
    font-family: "Inter";
    src: url("/fonts/inter-regular.subset.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: block;
    unicode-range: U+0020-007F, U+00A0-00FF, U+2018-201D, U+2026;
  }

  :root {
    --bg-primary: oklch(15.46% 0.0066 270.96);
    --text-accent: oklch(62.57% 0.08 278.83);
    --text-accent-strong: oklch(62.67% 0.2043 278.74);
    --text-primary: oklch(96.76% 0.01 273.36);
    --text-secondary: oklch(36.41% 0.0085 233.89);
    --text-link: oklch(54.16% 0.014 248.08);
    --brand-x: oklch(66.71% 0.1615 245.54);
    --brand-linkedin: oklch(53.13% 0.1301 243.65);
  }

  :root {
    view-transition-name: none;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  html {
    font-size: 1.2em;
    font-family: "Inter", system-ui, sans-serif;
    background-color: var(--bg-primary);
    color-scheme: dark;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  html,
  body {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .page-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh;
    height: 100dvh;
    padding: 2rem 1.25rem;
    overflow: hidden;
  }

  .panel {
    --panel-shell-padding: 14px;
    width: min(100%, 960px);
    max-height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    border: 1px solid oklch(100% 0 0 / 0.07);
    background: linear-gradient(
      180deg,
      oklch(19.64% 0.0168 268.77 / 0.95),
      oklch(16.91% 0.013 270.54 / 0.98)
    );
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 0.3),
      0 1rem 3rem oklch(0% 0 0 / 0.28),
      inset 0 1px 0 oklch(100% 0 0 / 0.04);
    overflow: hidden;
  }

  .panel--bookshelf,
  .panel--timeline {
    height: 100%;
  }

  .panel[data-panel-animating] {
    will-change: height;
  }

  .panel-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--panel-shell-padding);
    flex-shrink: 0;
  }

  .header-identity {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .header-avatar-shell {
    position: relative;
    width: 72px;
    height: 72px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid oklch(100% 0 0 / 0.08);
    box-shadow:
      0 0 0 1px oklch(0% 0 0 / 0.24),
      0 0.5rem 1.2rem oklch(0% 0 0 / 0.24);
    background: oklch(29% 0.018 253.5);
    flex-shrink: 0;
  }

  .header-avatar-shell .header-avatar-placeholder,
  .header-avatar-shell .header-avatar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 22%;
  }

  .header-avatar-shell .header-avatar-placeholder {
    transform: scale(1.04);
    filter: blur(4px) saturate(1.18) contrast(1.04);
  }

  .header-avatar-shell .header-avatar {
    z-index: 1;
  }

  .header-copy {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .header-name {
    font-family: "BrutalType", system-ui, sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .header-role {
    color: var(--text-secondary);
    font-size: 0.6rem;
  }

  .panel-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    --panel-inline-padding: 1.5rem;
  }

  .panel-main {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .panel-footer {
    flex-shrink: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.85rem;
    padding: var(--panel-shell-padding);
  }

  .panel-footer-center {
    grid-column: 2;
    min-width: 0;
    justify-self: center;
    align-self: center;
    text-align: center;
  }

  .panel-footer-social {
    grid-column: 3;
    align-self: center;
    display: flex;
    align-items: center;
    justify-self: end;
  }

  @media (max-width: 760px) {
    .page-wrap {
      padding: 1rem 0.75rem;
    }

    .panel-body {
      --panel-inline-padding: 1rem;
    }

    .panel-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      row-gap: 0.85rem;
      padding: var(--panel-shell-padding);
    }

    .panel-header > :last-child {
      width: 100%;
    }

    .header-identity {
      gap: 12px;
    }
  }
</style>

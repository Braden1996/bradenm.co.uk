---
import SitePanelTemplate from "../components/templates/site-panel-template.astro";
import type { SiteRoom } from "../components/lib/site-room";
import roomShellStyles from "../features/about/styles/room-shell.css?inline";

interface Props {
  description: string;
  /** Which room the shell dresses; the letter's rooms are the default. */
  room?: SiteRoom;
  title: string;
}

const { title, description, room = "about" } = Astro.props;
---

<SitePanelTemplate title={title} description={description} room={room}>
  <Fragment slot="head">
    <slot name="head" />
    {/* Shared room geometry is available before any room markup can paint. */}
    {room === "about" && <style is:inline set:html={roomShellStyles} />}
  </Fragment>
  <slot name="header" slot="header" />
  <slot />
</SitePanelTemplate>

---
interface Props {
  label: string;
  size?: "compact" | "regular";
}

const { label, size = "compact" } = Astro.props;
const normalizedLabel = label.trim().toLowerCase();

const palettes = {
  audiobook: {
    background: "linear-gradient(180deg, oklch(44.49% 0.0695 256.47), oklch(36.09% 0.0567 257.61))",
    border: "oklch(77.93% 0.0653 250.09 / 0.28)",
    shadow: "oklch(18.26% 0.0265 263.59 / 0.34)",
    text: "oklch(95.10% 0.0155 247.99 / 0.92)",
  },
  default: {
    background: "linear-gradient(180deg, oklch(43.81% 0.0299 265.29), oklch(36.74% 0.0276 265.38))",
    border: "oklch(81.27% 0.0272 264.41 / 0.22)",
    shadow: "oklch(18.35% 0.0191 270.16 / 0.28)",
    text: "oklch(95.11% 0.0103 261.79 / 0.86)",
  },
  kindle: {
    background: "linear-gradient(180deg, oklch(48.48% 0.0822 66.72), oklch(40.07% 0.0702 64.04))",
    border: "oklch(82.60% 0.0906 77.54 / 0.3)",
    shadow: "oklch(24.35% 0.0415 68.11 / 0.34)",
    text: "oklch(94.55% 0.0367 80.63 / 0.94)",
  },
  physical: {
    background: "linear-gradient(180deg, oklch(45.13% 0.0552 156.55), oklch(37.02% 0.044 158.29))",
    border: "oklch(76.95% 0.0629 160.79 / 0.28)",
    shadow: "oklch(19.57% 0.0213 155.95 / 0.32)",
    text: "oklch(94.22% 0.019 157.86 / 0.92)",
  },
} as const;

const palette =
  normalizedLabel in palettes
    ? palettes[normalizedLabel as keyof typeof palettes]
    : palettes.default;

const style = [
  `--medium-tag-background:${palette.background}`,
  `--medium-tag-border:${palette.border}`,
  `--medium-tag-shadow:${palette.shadow}`,
  `--medium-tag-text:${palette.text}`,
].join(";");
---

<span class:list={["medium-tag", `medium-tag--${size}`]} style={style}>
  {label}
</span>

<style>
  .medium-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: 0.12rem 0.48rem;
    border-radius: 999px;
    border: 1px solid var(--medium-tag-border);
    background: var(--medium-tag-background);
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.06),
      0 1px 2px var(--medium-tag-shadow);
    color: var(--medium-tag-text);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .medium-tag--regular {
    padding: 0.18rem 0.58rem;
    font-size: 0.62rem;
  }
</style>

---
import type { IconicIconName } from "../icons/iconic";
import IconicIcon from "./iconic-icon.astro";

const links: { href: string; label: string; icon: IconicIconName }[] = [
  { href: "https://x.com/SirBraden1996", label: "X", icon: "x" },
  { href: "https://github.com/Braden1996", label: "GitHub", icon: "github" },
  { href: "https://www.linkedin.com/in/braden-marshall/", label: "LinkedIn", icon: "linkedin" },
  { href: "https://steamcommunity.com/id/Braden1996", label: "Steam", icon: "steam" },
];
---

<nav class="footer-social-row" aria-label="Social links">
  {
    links.map(({ href, label, icon }) => (
      <a
        href={href}
        aria-label={label}
        class="footer-social-link"
        rel="noopener noreferrer"
        target="_blank"
      >
        <IconicIcon class="footer-social-icon" name={icon} />
      </a>
    ))
  }
</nav>

<style>
  .footer-social-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    line-height: 0;
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    line-height: 0;
    transition: color 200ms ease;
  }

  .footer-social-link:hover {
    color: var(--text-primary);
  }

  .footer-social-icon {
    display: block;
    width: 1rem;
    height: 1rem;
  }
</style>

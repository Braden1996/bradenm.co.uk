---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import ProgressiveImage from "./progressive-image.astro";
import ScrollFadeFrame from "./scroll-fade-frame.astro";

interface Props {
  entry: {
    Content: AstroComponentFactory;
    logoHeight?: number;
    logoPlaceholderDataUrl?: string;
    logoSrc?: string;
    logoWidth?: number;
    mark: string;
    organisation: string;
  };
}

const { entry } = Astro.props;
const { Content } = entry;
---

<div class="timeline-detail-content">
  <div class="timeline-detail-media">
    <div class="timeline-detail-media-shell">
      {
        entry.logoSrc ? (
          <ProgressiveImage
            placeholderClass="timeline-detail-media-logo-placeholder"
            placeholderSrc={entry.logoPlaceholderDataUrl}
            class="timeline-detail-media-logo"
            src={entry.logoSrc}
            alt={`${entry.organisation} logo`}
            width={entry.logoWidth}
            height={entry.logoHeight}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        ) : (
          <span class="timeline-detail-media-fallback" aria-hidden="true">
            {entry.mark}
          </span>
        )
      }
    </div>
    <span class="timeline-detail-media-note">Product or company image</span>
  </div>

  <ScrollFadeFrame class="timeline-detail-body-frame" tone="subtle">
    <div class="timeline-detail-body" data-scroll-fade-viewport data-detail-scroll-viewport>
      <div class="timeline-detail-copy">
        <Content />
      </div>
    </div>
  </ScrollFadeFrame>
</div>

<style>
  .timeline-detail-content {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 1rem;
    min-height: 0;
    width: 100%;
  }

  .timeline-detail-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 11rem;
    margin-right: 0.9rem;
    border-radius: 1.15rem;
    border: 1px solid oklch(100% 0 0 / 0.07);
    background:
      linear-gradient(180deg, oklch(100% 0 0 / 0.03), oklch(100% 0 0 / 0.015)),
      radial-gradient(circle at top left, oklch(100% 0 0 / 0.05), transparent 58%);
    overflow: hidden;
  }

  .timeline-detail-media-shell {
    position: relative;
    display: grid;
    place-items: center;
    width: min(8rem, 38%);
    aspect-ratio: 1;
    padding: 0.45rem;
    border-radius: 1.2rem;
    background: oklch(100% 0 0 / 0.05);
    border: 1px solid oklch(100% 0 0 / 0.08);
    box-shadow: 0 0.8rem 2rem oklch(0% 0 0 / 0.16);
  }

  :global(.timeline-detail-media-shell .timeline-detail-media-logo),
  :global(.timeline-detail-media-shell .timeline-detail-media-logo-placeholder),
  .timeline-detail-media-fallback {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 0.9rem;
  }

  :global(.timeline-detail-media-shell .timeline-detail-media-logo-placeholder) {
    transform: scale(1.04);
    filter: blur(6px) saturate(1.1) contrast(1.04);
  }

  :global(.timeline-detail-media-shell .timeline-detail-media-logo) {
    object-fit: contain;
    position: relative;
    z-index: 1;
  }

  .timeline-detail-media-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: oklch(100% 0 0 / 0.06);
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .timeline-detail-media-note {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    color: oklch(96.76% 0.0096 273.36 / 0.38);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline-detail-body-frame {
    min-height: 0;
  }

  .timeline-detail-body {
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: oklch(100% 0 0 / 0.08) oklch(0% 0 0 / 0);
    padding: 0 0 0.35rem;
  }

  .timeline-detail-copy {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-top: 0.1rem;
    padding-right: 0.9rem;
  }

  .timeline-detail-copy :global(p),
  .timeline-detail-copy :global(li) {
    color: oklch(96.76% 0.0096 273.36 / 0.62);
    font-size: 0.8rem;
    line-height: 1.68;
  }

  .timeline-detail-copy :global(p),
  .timeline-detail-copy :global(ul),
  .timeline-detail-copy :global(ol) {
    margin: 0;
  }

  .timeline-detail-copy :global(ul),
  .timeline-detail-copy :global(ol) {
    display: grid;
    gap: 0.7rem;
    padding: 0;
    list-style: none;
  }

  .timeline-detail-copy :global(li) {
    position: relative;
    padding-left: 1rem;
  }

  .timeline-detail-copy :global(li)::before {
    content: "";
    position: absolute;
    top: 0.52rem;
    left: 0;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: oklch(96.76% 0.0096 273.36 / 0.4);
  }

  .timeline-detail-copy :global(a) {
    color: var(--text-primary);
    text-decoration-color: oklch(96.76% 0.0096 273.36 / 0.34);
  }

  .timeline-detail-copy :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .timeline-detail-media {
      min-height: 9.5rem;
    }

    .timeline-detail-media-shell {
      width: min(7rem, 42%);
    }

    .timeline-detail-copy {
      padding-right: 0;
    }
  }
</style>

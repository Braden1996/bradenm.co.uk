---
import "../../styles/theme.css";
import { getFontAssets, getFontStyles } from "../lib/site-fonts";
import "../../styles/overlay-scrollbar.css";
import type { SiteRoom } from "../lib/site-room";
import PanelShell from "../organisms/panel-shell.astro";
import PaperBackdrop from "../organisms/paper-backdrop.astro";
import PaperOverscroll from "../organisms/paper-overscroll.astro";

interface Props {
  description: string;
  /** Which room the shell dresses; the letter's rooms are the default. */
  room?: SiteRoom;
  title: string;
}

const { title, description, room = "about" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const [fonts, fontStyles] = await Promise.all([getFontAssets(), getFontStyles()]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
    <style is:inline set:html={fontStyles}></style>
    {
      room !== "about" && (
        <link rel="preload" href={fonts.recoleta.url} as="font" type="font/woff2" crossorigin />
      )
    }
    <link
      rel="preload"
      href={fonts.sourceSans.url}
      as="font"
      type="font/woff2"
      fetchpriority="low"
      crossorigin
    />
    {
      /*
    Stamped before first paint so platform-specific key caps are laid out at the
    right width from the start rather than resizing the controls around them once
    a module has run. Mirrors `detectPlatform` from @tanstack/hotkeys: the two
    have to agree, or a cap advertises a chord the manager is not listening for.
    */
    }
    <script is:inline>
      (() => {
        const root = document.documentElement;

        const stampPlatform = () => {
          const platform = navigator.platform?.toLowerCase() ?? "";
          const userAgent = navigator.userAgent?.toLowerCase() ?? "";

          if (platform.includes("mac") || userAgent.includes("mac")) {
            root.dataset.platform = "mac";
            return;
          }

          if (platform.includes("win") || userAgent.includes("win")) {
            root.dataset.platform = "windows";
            return;
          }

          root.dataset.platform = "linux";
        };

        stampPlatform();
      })();
    </script>
  </head>

  <body>
    <script>
      import { initializeSite } from "../../scripts/site";

      initializeSite();
    </script>

    <PaperBackdrop />

    <PanelShell room={room}>
      <slot name="header" slot="header" />
      <slot />
    </PanelShell>

    <PaperOverscroll />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    view-transition-name: none;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  html {
    font-size: var(--font-size-root);
    font-family: var(--font-body);
    background-color: var(--color-bg-canvas);
    color-scheme: light;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  html,
  body {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  /* The scroll owner changes across this page's breakpoints — the document
     below the shell's mobile width, the page shell above it — and every
     surface on the site scrolls inside itself somewhere. None of them wears a
     native bar any more: overlay-scrollbar.css hides them and
     overlay-scrollbar.ts draws one soft ink thumb on top of the content
     instead, so nothing is reserved beside the sheet and nothing has to be
     painted under a track. */

  @media (max-width: 760px) {
    html {
      height: auto;
      min-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
    }

    body {
      height: auto;
      min-height: 100vh;
      min-height: 100dvh;
      overflow: visible;
    }
  }
</style>

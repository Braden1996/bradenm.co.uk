---
import Avatar from "../atoms/avatar.astro";
import profileImage from "../../../data/profile-image.json";
import SitePrimaryNav from "./site-primary-nav.astro";

interface Props {
  activeTab: "about" | "timeline" | "bookshelf";
}

const { activeTab } = Astro.props;
const headerProfileImage = profileImage;
const headerAvatarSize = "var(--site-header-avatar-size, 72px)";
---

<header class="site-header">
  <div class="site-header__identity">
    <div
      class="site-header__avatar-shell"
      style={`width:${headerAvatarSize};height:${headerAvatarSize};`}
      transition:persist
    >
      <Avatar
        class="site-header__avatar"
        style={`--avatar-size:${headerAvatarSize};`}
        src={headerProfileImage.src}
        alt="Portrait of Braden Marshall"
        width={headerProfileImage.width}
        height={headerProfileImage.height}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="site-header__copy">
      <span class="site-header__name">Braden Marshall</span>
      <span class="site-header__role">Senior Software Engineer</span>
    </div>
  </div>

  <div class="site-header__nav">
    <SitePrimaryNav activeTab={activeTab} />
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--panel-shell-padding);
    flex-shrink: 0;
  }

  .site-header__identity {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .site-header__avatar-shell {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 0;
  }

  .site-header__copy {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .site-header__name {
    font-family: "BrutalType", system-ui, sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .site-header__role {
    color: var(--color-text-muted);
    font-size: 0.6rem;
  }

  @media (max-width: 760px) {
    .site-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      row-gap: 0.85rem;
      padding: var(--panel-shell-padding);
    }

    .site-header__nav {
      width: 100%;
    }
  }
</style>

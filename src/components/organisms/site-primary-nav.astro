---
interface Props {
  activeTab: "about" | "timeline" | "bookshelf";
}

const { activeTab } = Astro.props;
const tabs = [
  { href: "/", key: "about" as const, label: "About" },
  { href: "/timeline", key: "timeline" as const, label: "Timeline" },
  { href: "/bookshelf", key: "bookshelf" as const, label: "Bookshelf" },
];
---

<nav class="tab-bar" aria-label="Primary navigation">
  <div class="tab-track" data-tab-track>
    <span class="tab-flight-pill" data-tab-flight-pill aria-hidden="true"></span>
    {
      tabs.map(({ href, key, label }) => (
        <a
          href={href}
          class:list={["tab", activeTab === key && "is-active"]}
          aria-current={activeTab === key ? "page" : undefined}
          data-tab-link
        >
          {activeTab === key && <span class="tab-static-pill" aria-hidden="true" />}
          <span class="tab-label">{label}</span>
        </a>
      ))
    }
  </div>
</nav>

<script>
  import { isPlainLeftClick } from "../../scripts/utils";

  const SITE_TAB_TRACK_SELECTOR = "[data-tab-track]";
  const SITE_TAB_LINK_SELECTOR = "[data-tab-link]";
  const SITE_TAB_FLIGHT_SELECTOR = "[data-tab-flight-pill]";

  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  function measureLink(link: HTMLElement, track: HTMLElement) {
    const trackRect = track.getBoundingClientRect();
    const linkRect = link.getBoundingClientRect();

    return {
      width: linkRect.width,
      x: linkRect.left - trackRect.left,
    };
  }

  function resetTrack(track: HTMLElement) {
    track.removeAttribute("data-transitioning");

    const flightPill = track.querySelector(SITE_TAB_FLIGHT_SELECTOR);

    if (!(flightPill instanceof HTMLElement)) {
      return;
    }

    flightPill.style.opacity = "";
    flightPill.style.transform = "";
    flightPill.style.width = "";
    flightPill.style.transition = "";
  }

  function resetAllTracks() {
    document.querySelectorAll(SITE_TAB_TRACK_SELECTOR).forEach((track) => {
      if (track instanceof HTMLElement) {
        resetTrack(track);
      }
    });
  }

  function startFlight(link: HTMLAnchorElement) {
    if (reducedMotionQuery?.matches) {
      return;
    }

    const track = link.closest(SITE_TAB_TRACK_SELECTOR);

    if (!(track instanceof HTMLElement)) {
      return;
    }

    const currentLink =
      track.querySelector(`${SITE_TAB_LINK_SELECTOR}[aria-current="page"]`) ??
      track.querySelector(SITE_TAB_LINK_SELECTOR);
    const flightPill = track.querySelector(SITE_TAB_FLIGHT_SELECTOR);

    if (
      !(currentLink instanceof HTMLElement) ||
      !(flightPill instanceof HTMLElement) ||
      currentLink === link
    ) {
      resetTrack(track);
      return;
    }

    const start = measureLink(currentLink, track);
    const end = measureLink(link, track);

    track.dataset.transitioning = "true";
    flightPill.style.transition = "none";
    flightPill.style.opacity = "1";
    flightPill.style.transform = `translateX(${start.x}px)`;
    flightPill.style.width = `${start.width}px`;
    flightPill.getBoundingClientRect();

    requestAnimationFrame(() => {
      if (!track.isConnected || track.dataset.transitioning !== "true") {
        return;
      }

      flightPill.style.transition = "";
      flightPill.style.transform = `translateX(${end.x}px)`;
      flightPill.style.width = `${end.width}px`;
    });
  }

  if (!document.documentElement.dataset.siteTabsBound) {
    document.documentElement.dataset.siteTabsBound = "true";

    document.addEventListener(
      "click",
      (event) => {
        if (!(event.target instanceof Element) || !isPlainLeftClick(event)) {
          return;
        }

        const link = event.target.closest(SITE_TAB_LINK_SELECTOR);

        if (!(link instanceof HTMLAnchorElement) || link.getAttribute("aria-current") === "page") {
          return;
        }

        startFlight(link);
      },
      true,
    );

    document.addEventListener("astro:after-swap", resetAllTracks);
    document.addEventListener("astro:page-load", resetAllTracks);
    window.addEventListener("resize", resetAllTracks);
  }
</script>

<style>
  .tab-bar {
    display: flex;
  }

  .tab-track {
    position: relative;
    display: inline-flex;
    gap: 2px;
    width: fit-content;
    max-width: 100%;
    padding: 3px;
    border-radius: 0.6rem;
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border-ghost);
    overflow: hidden;
    isolation: isolate;
  }

  .tab {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    padding: 0.38rem 1rem;
    border-radius: 0.45rem;
    text-decoration: none;
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--color-text-interactive);
    transition: color 220ms ease;
    cursor: pointer;
  }

  .tab:hover {
    color: var(--color-text-interactive-hover);
  }

  .tab.is-active {
    color: var(--color-text-interactive-active);
  }

  .tab-flight-pill,
  .tab-static-pill {
    border-radius: 0.45rem;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-soft);
    box-shadow: 0 1px 3px var(--color-shadow-subtle);
    pointer-events: none;
  }

  .tab-flight-pill {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 0;
    opacity: 0;
    z-index: 0;
    transform: translateX(0);
    transition:
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
      width 180ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 120ms ease;
    will-change: transform, width;
  }

  .tab-static-pill {
    position: absolute;
    inset: 0;
    z-index: 0;
    transition: opacity 120ms ease;
  }

  .tab-track[data-transitioning="true"] .tab-static-pill {
    opacity: 0;
  }

  .tab-label {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .tab,
    .tab-static-pill,
    .tab-flight-pill {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .tab-track {
      display: flex;
      width: 100%;
    }

    .tab {
      min-width: 0;
      padding-inline: 0.8rem;
    }
  }
</style>

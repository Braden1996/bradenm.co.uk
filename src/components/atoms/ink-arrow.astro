---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"svg"> {
  inkId: string;
  ink: string;
  tail: string;
  hidden?: boolean;
}
const { inkId, ink, tail, class: className, style, ...rest } = Astro.props;
---

<svg
  class:list={["ink-arrow", className]}
  aria-hidden="true"
  viewBox="0 0 80 64"
  preserveAspectRatio="none"
  fill="none"
  style={`--ink-arrow-stroke:url(#${inkId});${style ?? ""}`}
  {...rest}
>
  <defs>
    <linearGradient id={inkId} x1="100%" y1="0%" x2="0%" y2="0%">
      <stop offset="0" stop-color={ink}></stop>
      <stop offset="1" stop-color={tail}></stop>
    </linearGradient>
  </defs>
  <slot />
</svg>

<style>
  .ink-arrow {
    pointer-events: none;
  }
  .ink-arrow :global(path) {
    stroke: var(--ink-arrow-stroke);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
    vector-effect: non-scaling-stroke;
  }
  @media (forced-colors: active) {
    .ink-arrow :global(path) {
      stroke: LinkText;
    }
  }
</style>

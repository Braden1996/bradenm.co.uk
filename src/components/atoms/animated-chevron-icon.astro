---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["animated-chevron-icon", className]} aria-hidden="true">
  <svg viewBox="0 0 24 24" focusable="false">
    <path
      class="animated-chevron-icon__path animated-chevron-icon__path--up"
      d="M6.75 14.75L12 9.5L17.25 14.75"
      pathLength="1"></path>
    <path
      class="animated-chevron-icon__path animated-chevron-icon__path--down"
      d="M6.75 9.25L12 14.5L17.25 9.25"
      pathLength="1"></path>
  </svg>
</span>

<style>
  .animated-chevron-icon {
    --animated-chevron-scale: 0.96;
    --animated-chevron-up-opacity: 0;
    --animated-chevron-down-opacity: 0.62;
    --animated-chevron-up-shift: 2px;
    --animated-chevron-down-shift: 0px;
    --animated-chevron-up-dashoffset: 0.18;
    --animated-chevron-down-dashoffset: 0.02;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1em;
    height: 1em;
    color: inherit;
    line-height: 0;
  }

  .animated-chevron-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: scale(var(--animated-chevron-scale));
    transform-origin: center;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .animated-chevron-icon__path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    transform-box: fill-box;
    transform-origin: center;
    vector-effect: non-scaling-stroke;
    will-change: opacity, stroke-dashoffset, transform;
    transition:
      opacity 180ms ease,
      stroke-dashoffset 220ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .animated-chevron-icon__path--up {
    opacity: var(--animated-chevron-up-opacity);
    stroke-dashoffset: var(--animated-chevron-up-dashoffset);
    transform: translateY(var(--animated-chevron-up-shift));
  }

  .animated-chevron-icon__path--down {
    opacity: var(--animated-chevron-down-opacity);
    stroke-dashoffset: var(--animated-chevron-down-dashoffset);
    transform: translateY(var(--animated-chevron-down-shift));
  }

  @media (prefers-reduced-motion: reduce) {
    .animated-chevron-icon svg,
    .animated-chevron-icon__path {
      transition: none;
    }
  }
</style>

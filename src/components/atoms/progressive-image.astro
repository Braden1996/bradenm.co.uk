---
import { Image } from "astro:assets";

const {
  alt,
  class: className,
  decoding = "async",
  fetchpriority,
  height,
  loading = "lazy",
  placeholderSrc,
  src,
  width,
  ...rest
} = Astro.props;
---

<span class:list={["progressive-image", className]} {...rest}>
  {
    placeholderSrc && (
      <img
        class="progressive-image__placeholder"
        src={placeholderSrc}
        alt=""
        aria-hidden="true"
        width={width}
        height={height}
        loading="eager"
        decoding="async"
      />
    )
  }
  {
    src && (
      <Image
        class="progressive-image__image"
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
      />
    )
  }
</span>

<style>
  .progressive-image {
    --progressive-image-fit: cover;
    --progressive-image-image-position: center;
    --progressive-image-placeholder-fit: var(--progressive-image-fit);
    --progressive-image-placeholder-position: var(--progressive-image-image-position);
    --progressive-image-radius: 0;
    --progressive-image-placeholder-filter: none;
    --progressive-image-placeholder-transform: none;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .progressive-image__placeholder,
  .progressive-image__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    border-radius: var(--progressive-image-radius);
  }

  .progressive-image__placeholder {
    object-fit: var(--progressive-image-placeholder-fit);
    object-position: var(--progressive-image-placeholder-position);
    filter: var(--progressive-image-placeholder-filter);
    transform: var(--progressive-image-placeholder-transform);
  }

  .progressive-image__image {
    object-fit: var(--progressive-image-fit);
    object-position: var(--progressive-image-image-position);
    z-index: 1;
  }
</style>

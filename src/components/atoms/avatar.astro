---
import type { HTMLAttributes } from "astro/types";
import ProgressiveImage from "./progressive-image.astro";

interface Props extends HTMLAttributes<"span"> {
  alt?: string;
  decoding?: "async" | "auto" | "sync";
  fetchpriority?: "auto" | "high" | "low";
  height: number;
  imagePosition?: string;
  loading?: "eager" | "lazy";
  placeholderSrc?: string;
  src?: string;
  width: number;
}

const {
  alt = "",
  class: className,
  decoding = "async",
  fetchpriority,
  height,
  imagePosition = "center 22%",
  loading = "lazy",
  placeholderSrc,
  src,
  style,
  width,
  ...rest
} = Astro.props;
const avatarStyle = [style, `--avatar-image-position:${imagePosition};`].filter(Boolean).join(" ");
---

<span class:list={["avatar", className]} style={avatarStyle} {...rest}>
  <ProgressiveImage
    class="avatar__image"
    placeholderSrc={placeholderSrc}
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
  />
</span>

<style>
  .avatar {
    --avatar-size: var(--symbol-size, 2rem);
    --avatar-radius: calc(var(--avatar-size) * 0.1944444444);
    --avatar-border-color: var(--color-border-strong);
    --avatar-shadow: var(--shadow-elevated);
    --avatar-background: var(--color-surface-elevated);
    --avatar-image-position: center 22%;
    --avatar-placeholder-position: var(--avatar-image-position);
    --avatar-placeholder-transform: scale(1.04);
    --avatar-placeholder-filter: blur(4px) saturate(1.18) contrast(1.04);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    min-width: var(--avatar-size);
    border-radius: var(--avatar-radius);
    overflow: hidden;
    border: 1px solid var(--avatar-border-color);
    box-shadow: var(--avatar-shadow);
    background: var(--avatar-background);
    flex: none;
  }

  .avatar__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    --progressive-image-fit: cover;
    --progressive-image-image-position: var(--avatar-image-position);
    --progressive-image-placeholder-position: var(--avatar-placeholder-position);
    --progressive-image-radius: var(--avatar-radius);
    --progressive-image-placeholder-transform: var(--avatar-placeholder-transform);
    --progressive-image-placeholder-filter: var(--avatar-placeholder-filter);
  }
</style>

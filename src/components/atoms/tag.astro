---
interface Props {
  label: string;
  size?: "compact" | "regular";
  variant?: "neutral" | "info" | "success" | "warning";
}

const { label, size = "compact", variant = "neutral" } = Astro.props;
---

<span class:list={["tag", `tag--${size}`, `tag--${variant}`]}>
  {label}
</span>

<style>
  .tag {
    --tag-background: var(--color-tag-neutral-bg);
    --tag-border: var(--color-tag-neutral-border);
    --tag-shadow: var(--color-tag-neutral-shadow);
    --tag-text: var(--color-tag-neutral-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: 0.12rem 0.48rem;
    border-radius: 999px;
    border: 1px solid var(--tag-border);
    background: var(--tag-background);
    box-shadow:
      inset 0 1px 0 var(--color-surface-highlight-soft),
      0 1px 2px var(--tag-shadow);
    color: var(--tag-text);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .tag--regular {
    padding: 0.18rem 0.58rem;
    font-size: 0.62rem;
  }

  .tag--info {
    --tag-background: var(--color-tag-info-bg);
    --tag-border: var(--color-tag-info-border);
    --tag-shadow: var(--color-tag-info-shadow);
    --tag-text: var(--color-tag-info-text);
  }

  .tag--success {
    --tag-background: var(--color-tag-success-bg);
    --tag-border: var(--color-tag-success-border);
    --tag-shadow: var(--color-tag-success-shadow);
    --tag-text: var(--color-tag-success-text);
  }

  .tag--warning {
    --tag-background: var(--color-tag-warning-bg);
    --tag-border: var(--color-tag-warning-border);
    --tag-shadow: var(--color-tag-warning-shadow);
    --tag-text: var(--color-tag-warning-text);
  }
</style>

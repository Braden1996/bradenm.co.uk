---
import MediumTag from "./medium-tag.astro";

interface Props {
  class?: string;
  mediums: string[];
  size?: "compact" | "regular";
}

const { class: className, mediums, size = "compact" } = Astro.props;
const items = mediums.filter((medium): medium is string => Boolean(medium?.trim()));
---

{
  items.length > 0 && (
    <span class:list={["medium-tag-group", className]}>
      {items.map((medium, index) => (
        <span
          class="medium-tag-group-item"
          style={`--medium-tag-offset:${Math.max(items.length - index - 1, 0)};--medium-tag-z-index:${index + 1};`}
        >
          <MediumTag label={medium} size={size} />
        </span>
      ))}
    </span>
  )
}

<style>
  .medium-tag-group {
    --medium-tag-gap: 0.36rem;
    --medium-tag-overlap: 0.7rem;
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    align-items: center;
    column-gap: var(--medium-tag-gap);
    min-width: 0;
    isolation: isolate;
    white-space: nowrap;
  }

  .medium-tag-group-item {
    display: inline-flex;
    grid-row: 1;
    position: relative;
    transform: translateX(calc(var(--medium-tag-offset) * var(--medium-tag-overlap)));
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    z-index: var(--medium-tag-z-index);
  }

  .medium-tag-group:is(:hover, :focus-within) .medium-tag-group-item {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .medium-tag-group-item {
      transition: none;
    }
  }
</style>

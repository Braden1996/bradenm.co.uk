---
import IconicIcon from "../atoms/iconic-icon.astro";
import ShortcutHint from "../atoms/shortcut-hint.astro";
import { siteMarkStrokeStyle } from "../lib/site-mark-stroke";

interface Props {
  width?: string;
  id: string;
  label: string;
  placeholder?: string;
}

const { width = "13rem", id, label, placeholder = "Search" } = Astro.props;
const markStyle = await siteMarkStrokeStyle();
---

<div
  class="overlay-search-bar"
  style={`--overlay-search-width:${width};${markStyle}`}
  data-overlay-search
>
  <div class="overlay-search-shell">
    <IconicIcon name="search" />
    <input
      id={id}
      type="search"
      aria-label={label}
      aria-keyshortcuts="/ Meta+k Control+k"
      autocomplete="off"
      spellcheck="false"
      placeholder={placeholder}
      data-search-input
    />
    <div class="overlay-search-shortcuts">
      <ShortcutHint
        as="button"
        class="overlay-search-focus"
        hotkey="/"
        label="Focus search"
        type="button"
        tabindex="-1"
        aria-controls={id}
        data-focus-search
      />
      <ShortcutHint
        as="button"
        class="overlay-search-clear"
        hotkey="Escape"
        label="Leave search"
        type="button"
        aria-controls={id}
        data-clear-search
      />
    </div>
  </div>
</div>

<style>
  .overlay-search-bar {
    position: relative;
    width: var(--overlay-search-width);
    height: var(--control-lg);
    max-width: 100%;
  }

  .overlay-search-shell {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    /* Match the space the navigation reserves below its text for the active mark. */
    padding-block-end: calc(var(--space-3) + var(--text-label) * 0.4);
    color: var(--color-text-muted);
    padding-inline: var(--space-4) 0;
    /* Keep the field's existing footprint while the line is painted over it. */
    border-bottom: 1px solid transparent;
  }

  .overlay-search-shell::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: calc(var(--text-label) * 0.4);
    background-image: var(
      --site-mark-stroke,
      linear-gradient(90deg, var(--site-mark-start) 0%, var(--site-mark-end) 100%)
    );
    background-repeat: no-repeat;
    background-size: 100% 100%;
    opacity: 0.65;
    pointer-events: none;
  }

  /* Both caps size this cell from first paint, so focus changes only the ink. */
  .overlay-search-shortcuts {
    display: grid;
    flex: none;
  }

  .overlay-search-shortcuts :global(.shortcut-hint) {
    grid-area: 1 / 1;
    justify-self: end;
  }

  .overlay-search-clear,
  .overlay-search-shell:focus-within .overlay-search-focus {
    visibility: hidden;
  }

  .overlay-search-shell:focus-within .overlay-search-clear {
    visibility: visible;
  }

  .overlay-search-shell:focus-within::after {
    opacity: 1;
  }

  .overlay-search-shell input {
    appearance: none;
    width: 100%;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-text-primary);
    font-family: var(--font-body);
    font-size: var(--text-ui);
  }

  .overlay-search-shell input::placeholder {
    color: var(--color-text-faint);
    opacity: 1;
  }

  .overlay-search-shell input::-webkit-search-cancel-button {
    appearance: none;
  }

  .overlay-search-bar :global(.iconic-icon) {
    flex: none;
    font-size: var(--text-ui);
  }

  .overlay-search-bar :global(.shortcut-hint) {
    background: transparent;
    box-shadow: none;
  }

  @media (max-width: 760px) {
    .overlay-search-shell input {
      /* Keep iOS from zooming the sheet on focus. */
      font-size: max(16px, var(--text-ui));
    }
  }

  @media (forced-colors: active), print {
    .overlay-search-shell {
      border-bottom-color: currentColor;
    }

    .overlay-search-shell:focus-within {
      border-bottom-color: Highlight;
    }

    .overlay-search-shell::after {
      content: none;
    }
  }
</style>

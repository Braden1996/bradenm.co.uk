---
import IconicIcon from "../atoms/iconic-icon.astro";

interface Props {
  class?: string;
  closedLabel?: string;
  expandedWidth?: string;
  id: string;
  label: string;
  mode?: "heading" | "inline" | "overlay";
  placeholder?: string;
}

const {
  class: className,
  closedLabel = "",
  expandedWidth = "11rem",
  id,
  label,
  mode = "overlay",
  placeholder = "Find...",
} = Astro.props;
const isHeading = mode === "heading";
const isInline = mode === "inline";
const hasHeadingMetaSlot = Astro.slots.has("heading-meta");
---

<div
  class:list={[
    "overlay-search-bar",
    isHeading && "overlay-search-bar--heading",
    isInline && "overlay-search-bar--inline",
    className,
  ]}
  style={`--overlay-search-expanded-width:${expandedWidth};`}
  data-overlay-search
  data-overlay-search-mode={mode}
  data-overlay-search-ready="false"
  data-state={isInline ? "open" : "closed"}
>
  {
    !isInline && (
      <button
        class="overlay-search-trigger"
        type="button"
        aria-label={label}
        aria-controls={id}
        aria-expanded="false"
        data-overlay-search-trigger
      >
        <IconicIcon class="overlay-search-icon" name="search" />
      </button>
    )
  }

  {
    isHeading && (
      <div class="overlay-search-heading-meta">
        {hasHeadingMetaSlot ? (
          <slot name="heading-meta" />
        ) : (
          <>
            <span class="overlay-search-heading-label" aria-hidden="true">
              {closedLabel}
            </span>
            <slot name="heading-end" />
          </>
        )}
      </div>
    )
  }

  <label class="overlay-search-shell" for={id}>
    <span class="overlay-search-sr-only">{label}</span>
    {!isHeading && <IconicIcon class="overlay-search-icon" name="search" />}
    <input
      id={id}
      type="search"
      autocomplete="off"
      placeholder={placeholder}
      tabindex={isInline ? undefined : -1}
      data-search-input
    />
    <button
      class="overlay-search-clear"
      type="button"
      aria-label="Clear search"
      data-clear-search
      hidden
    >
      <IconicIcon class="overlay-search-clear-icon" name="close" />
    </button>
  </label>
</div>

<script>
  const HEADING_MOBILE_MEDIA_QUERY = "(max-width: 760px)";
  const controllers = new WeakMap<HTMLElement, AbortController>();

  const getOverlaySearchRoots = (scope: ParentNode = document) => {
    const roots =
      scope instanceof HTMLElement && scope.matches("[data-overlay-search]") ? [scope] : [];

    if ("querySelectorAll" in scope) {
      roots.push(...scope.querySelectorAll<HTMLElement>("[data-overlay-search]"));
    }

    return roots;
  };

  const destroyOverlaySearchBars = (scope: ParentNode = document) => {
    for (const root of getOverlaySearchRoots(scope)) {
      controllers.get(root)?.abort();
      controllers.delete(root);
    }
  };

  const initializeOverlaySearchBars = () => {
    for (const root of getOverlaySearchRoots()) {
      if (controllers.has(root)) {
        continue;
      }

      const controller = new AbortController();
      const { signal } = controller;

      controllers.set(root, controller);
      root.dataset.overlaySearchInitialized = "true";

      const mode = root.dataset.overlaySearchMode ?? "overlay";
      const input = root.querySelector<HTMLInputElement>("[data-search-input]");
      const trigger = root.querySelector<HTMLButtonElement>("[data-overlay-search-trigger]");
      const mobileQuery = window.matchMedia(HEADING_MOBILE_MEDIA_QUERY);

      const isForcedOpen = () =>
        mode === "inline" || (mode === "heading" && Boolean(mobileQuery?.matches));

      if (!input) {
        continue;
      }

      if (!trigger && mode !== "inline") {
        continue;
      }

      const syncOpenState = (requestedOpen: boolean) => {
        const isOpen = isForcedOpen() || requestedOpen;

        root.dataset.state = isOpen ? "open" : "closed";

        if (trigger) {
          trigger.setAttribute("aria-expanded", String(isOpen));
        }

        if (isOpen) {
          input.removeAttribute("tabindex");
        } else {
          input.tabIndex = -1;
        }
      };

      const open = (focusInput = false) => {
        syncOpenState(true);

        if (!focusInput) {
          return;
        }

        requestAnimationFrame(() => {
          input.focus();
          input.select();
        });
      };

      const close = (focusTrigger = false) => {
        if (isForcedOpen()) {
          return;
        }

        if (input.value.trim() !== "") {
          return;
        }

        syncOpenState(false);

        if (!focusTrigger || !trigger) {
          return;
        }

        requestAnimationFrame(() => {
          trigger.focus();
        });
      };

      if (trigger) {
        trigger.addEventListener("click", () => open(true), { signal });
      }

      input.addEventListener("focus", () => open(), { signal });
      input.addEventListener(
        "keydown",
        (event) => {
          if (event.key !== "Escape") {
            return;
          }

          if (input.value.length > 0) {
            input.value = "";
            input.dispatchEvent(new Event("input", { bubbles: true }));
            return;
          }

          close(true);
        },
        { signal },
      );

      root.addEventListener(
        "focusout",
        () => {
          requestAnimationFrame(() => {
            if (!root.contains(document.activeElement)) {
              close();
            }
          });
        },
        { signal },
      );

      if (mode === "heading" && mobileQuery) {
        const syncWithViewport = () => {
          syncOpenState(input.value.trim() !== "");
        };

        mobileQuery.addEventListener("change", syncWithViewport, { signal });
      }

      syncOpenState(input.value.trim() !== "");

      requestAnimationFrame(() => {
        if (!root.isConnected) {
          return;
        }

        root.dataset.overlaySearchReady = "true";
      });
    }
  };

  initializeOverlaySearchBars();

  if (!document.documentElement.dataset.overlaySearchBarsBound) {
    document.documentElement.dataset.overlaySearchBarsBound = "true";
    document.addEventListener("astro:before-swap", () => destroyOverlaySearchBars());
    document.addEventListener("astro:page-load", initializeOverlaySearchBars);
  }
</script>

<style>
  .overlay-search-bar {
    --overlay-search-background: var(--color-surface-panel-translucent);
    --overlay-search-border: var(--color-border-strong);
    --overlay-search-border-active: var(--color-focus-ring);
    --overlay-search-foreground: color-mix(in srgb, var(--color-text-primary) 84%, transparent);
    --overlay-search-faint: var(--color-text-faint);
    --overlay-search-trigger-size: 2rem;
    position: absolute;
    top: var(--overlay-search-top-offset, 0.2rem);
    right: var(--overlay-search-inline-offset, 0);
    z-index: 4;
    width: var(--overlay-search-trigger-size);
    height: var(--overlay-search-trigger-size);
    max-width: calc(100vw - 2.5rem);
    transition: width 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .overlay-search-bar[data-overlay-search-mode="overlay"][data-state="open"] {
    width: min(var(--overlay-search-expanded-width), calc(100vw - 2.5rem));
  }

  .overlay-search-bar--inline {
    position: relative;
    top: auto;
    right: auto;
    z-index: auto;
    width: min(var(--overlay-search-expanded-width), 100%);
    height: auto;
    max-width: 100%;
    transition: none;
  }

  .overlay-search-bar--heading {
    position: relative;
    top: auto;
    right: auto;
    z-index: auto;
    display: grid;
    grid-template-columns: var(--overlay-search-heading-trigger-column, 1.6rem) minmax(0, 1fr);
    column-gap: var(--overlay-search-heading-gap, 0.65rem);
    align-items: center;
    width: 100%;
    min-height: var(--overlay-search-trigger-size);
    height: auto;
    min-width: 0;
    max-width: none;
    justify-self: stretch;
    transition: none;
  }

  .overlay-search-trigger,
  .overlay-search-shell {
    position: absolute;
    inset: 0;
    border-radius: 0.72rem;
  }

  .overlay-search-trigger {
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--overlay-search-border);
    background: var(--color-surface-subtle);
    color: var(--overlay-search-faint);
    cursor: pointer;
    opacity: 0.44;
    backdrop-filter: blur(10px) saturate(0.78);
    -webkit-backdrop-filter: blur(10px) saturate(0.78);
    transition:
      opacity 180ms ease,
      color 180ms ease,
      background-color 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .overlay-search-trigger:hover,
  .overlay-search-trigger:focus-visible {
    opacity: 0.9;
    color: var(--overlay-search-foreground);
    background: var(--color-surface-panel-translucent-soft);
  }

  .overlay-search-trigger:focus-visible {
    outline: 1px solid var(--overlay-search-border-active);
    outline-offset: 2px;
  }

  .overlay-search-bar[data-overlay-search-mode="overlay"][data-state="open"]
    .overlay-search-trigger {
    opacity: 0;
    transform: scale(0.9);
    pointer-events: none;
  }

  .overlay-search-bar--heading .overlay-search-trigger {
    position: relative;
    inset: auto;
    grid-column: 1;
    grid-row: 1;
    justify-self: center;
    width: 0.96rem;
    height: 0.96rem;
    border: 0;
    background: transparent;
    color: var(--overlay-search-faint);
    opacity: 0.58;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .overlay-search-bar--heading .overlay-search-trigger:hover,
  .overlay-search-bar--heading .overlay-search-trigger:focus-visible {
    opacity: 1;
    color: var(--overlay-search-foreground);
    background: transparent;
  }

  .overlay-search-bar--heading .overlay-search-trigger:focus-visible {
    outline: none;
  }

  .overlay-search-bar--heading[data-state="open"] .overlay-search-trigger {
    opacity: 1;
    color: var(--overlay-search-foreground);
    background: transparent;
    transform: none;
    pointer-events: auto;
  }

  .overlay-search-shell {
    display: flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0 0.52rem;
    overflow: hidden;
    border: 1px solid var(--overlay-search-border);
    background: var(--overlay-search-background);
    color: var(--overlay-search-foreground);
    opacity: 0;
    transform: scale(0.94);
    pointer-events: none;
    backdrop-filter: blur(16px) saturate(0.9);
    -webkit-backdrop-filter: blur(16px) saturate(0.9);
    box-shadow: 0 0 0 1px var(--color-surface-sheen);
    transition:
      opacity 160ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .overlay-search-bar[data-state="open"] .overlay-search-shell {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .overlay-search-bar--heading .overlay-search-heading-meta,
  .overlay-search-bar--heading .overlay-search-shell {
    grid-column: 2;
    grid-row: 1;
  }

  .overlay-search-heading-meta {
    display: inline-flex;
    align-items: center;
    gap: var(--overlay-search-heading-label-gap, 0.18rem);
    min-width: 0;
    color: var(--overlay-search-heading-meta-color, inherit);
    font-size: var(--overlay-search-heading-meta-font-size, inherit);
    font-weight: var(--overlay-search-heading-meta-font-weight, inherit);
    letter-spacing: var(--overlay-search-heading-meta-letter-spacing, normal);
    line-height: var(--overlay-search-heading-meta-line-height, normal);
    text-transform: var(--overlay-search-heading-meta-text-transform, none);
    white-space: var(--overlay-search-heading-meta-white-space, normal);
    transition:
      opacity 140ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .overlay-search-heading-label {
    min-width: 0;
    color: var(--overlay-search-faint);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .overlay-search-bar--heading[data-state="open"] .overlay-search-heading-meta {
    opacity: 0;
    transform: translateX(-0.2rem);
    pointer-events: none;
  }

  .overlay-search-bar--heading .overlay-search-shell {
    --overlay-search-heading-shell-background: var(--color-surface-overlay);
    --overlay-search-heading-shell-border: var(--color-border-interactive);
    --overlay-search-heading-shell-padding-left: 0.38rem;
    --overlay-search-heading-shell-padding-right: 0.42rem;
    --overlay-search-heading-clear-size: 0.82rem;
    --overlay-search-heading-clear-right: 0.36rem;
    position: relative;
    inset: auto;
    width: min(10.65rem, 100%);
    min-height: 1.72rem;
    min-width: 0;
    justify-self: start;
    align-self: center;
    padding: 0 var(--overlay-search-heading-shell-padding-right) 0
      var(--overlay-search-heading-shell-padding-left);
    gap: 0.24rem;
    border: 1px solid var(--overlay-search-heading-shell-border);
    border-radius: 0.58rem;
    background: var(--overlay-search-heading-shell-background);
    box-shadow: inset 0 1px 0 var(--color-border-interactive-soft);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    transform: translateX(-0.44rem);
    transform-origin: left center;
  }

  .overlay-search-bar--heading .overlay-search-shell:focus-within {
    --overlay-search-heading-shell-border: var(--color-border-accent-soft);
    --overlay-search-heading-shell-background: var(--color-surface-overlay-strong);
    box-shadow:
      inset 0 1px 0 var(--color-border-interactive),
      0 0 0 1px var(--color-border-accent-ghost);
  }

  .overlay-search-bar--heading .overlay-search-shell::after {
    content: "";
    position: absolute;
    top: 1px;
    right: 1px;
    bottom: 1px;
    width: 2.4rem;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      transparent,
      var(--overlay-search-heading-shell-background) 68%
    );
    pointer-events: none;
    z-index: 1;
  }

  .overlay-search-bar--heading[data-state="open"] .overlay-search-shell {
    transform: translateX(-0.22rem);
  }

  .overlay-search-bar--heading .overlay-search-shell .overlay-search-icon {
    color: var(--overlay-search-faint);
  }

  .overlay-search-bar--inline .overlay-search-shell {
    position: relative;
    inset: auto;
    min-height: 2rem;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .overlay-search-shell:focus-within {
    border-color: var(--overlay-search-border-active);
    background: var(--color-surface-panel-translucent-strong);
  }

  .overlay-search-icon {
    flex-shrink: 0;
    width: 0.82rem;
    height: 0.82rem;
    color: currentColor;
  }

  .overlay-search-shell .overlay-search-icon {
    color: var(--overlay-search-faint);
  }

  .overlay-search-shell input {
    position: relative;
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    color: inherit;
    font: inherit;
    font-size: 0.75rem;
    opacity: 0;
    transform: translateX(0.25rem);
    pointer-events: none;
    transition:
      opacity 150ms ease 70ms,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1) 40ms;
  }

  .overlay-search-bar[data-state="open"] .overlay-search-shell input {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .overlay-search-bar--inline .overlay-search-shell input {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .overlay-search-bar--heading .overlay-search-shell input {
    min-width: 0;
    margin-left: -0.12rem;
    padding-left: 0.12rem;
    padding-right: 0.2rem;
    font-size: 0.71rem;
    z-index: 0;
  }

  .overlay-search-shell input::-webkit-search-cancel-button,
  .overlay-search-shell input::-webkit-search-decoration,
  .overlay-search-shell input::-webkit-search-results-button,
  .overlay-search-shell input::-webkit-search-results-decoration {
    display: none;
    -webkit-appearance: none;
  }

  .overlay-search-shell input::-ms-clear,
  .overlay-search-shell input::-ms-reveal {
    display: none;
    width: 0;
    height: 0;
  }

  .overlay-search-bar--heading .overlay-search-shell input::placeholder {
    color: var(--color-text-placeholder);
  }

  .overlay-search-shell input::placeholder {
    color: var(--overlay-search-faint);
  }

  .overlay-search-shell input:focus {
    outline: none;
  }

  .overlay-search-clear {
    width: 1rem;
    height: 1rem;
    padding: 0;
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    border: 0;
    border-radius: 999px;
    background: var(--color-surface-interactive);
    color: var(--overlay-search-faint);
    font: inherit;
    font-size: 0.82rem;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .overlay-search-clear:hover {
    background: var(--color-surface-interactive-hover-strong);
    color: var(--overlay-search-foreground);
  }

  .overlay-search-bar--heading .overlay-search-clear {
    position: absolute;
    top: 50%;
    right: var(--overlay-search-heading-clear-right);
    transform: translateY(-50%);
    width: 0.82rem;
    height: 0.82rem;
    background: transparent;
    color: color-mix(in srgb, var(--color-text-faint) 90%, transparent);
    z-index: 2;
  }

  .overlay-search-bar--heading .overlay-search-clear:hover {
    background: transparent;
    color: color-mix(in srgb, var(--color-text-primary) 56%, transparent);
  }

  .overlay-search-clear-icon {
    width: 0.66rem;
    height: 0.66rem;
  }

  .overlay-search-bar[data-overlay-search-ready="false"],
  .overlay-search-bar[data-overlay-search-ready="false"] .overlay-search-trigger,
  .overlay-search-bar[data-overlay-search-ready="false"] .overlay-search-heading-meta,
  .overlay-search-bar[data-overlay-search-ready="false"] .overlay-search-shell,
  .overlay-search-bar[data-overlay-search-ready="false"] .overlay-search-shell input,
  .overlay-search-bar[data-overlay-search-ready="false"] .overlay-search-clear {
    transition: none;
  }

  .overlay-search-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .overlay-search-bar {
      top: var(--overlay-search-top-offset-mobile, var(--overlay-search-top-offset, 0));
    }

    .overlay-search-bar--heading {
      width: 100%;
      max-width: 100%;
      grid-template-columns: 1fr;
    }

    .overlay-search-bar--heading .overlay-search-trigger,
    .overlay-search-bar--heading .overlay-search-heading-label,
    .overlay-search-bar--heading .overlay-search-heading-meta {
      display: none;
    }

    .overlay-search-bar--heading .overlay-search-shell {
      grid-column: 1;
      width: 100%;
      min-height: 1.9rem;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .overlay-search-bar--heading .overlay-search-shell input {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .overlay-search-bar,
    .overlay-search-trigger,
    .overlay-search-heading-label,
    .overlay-search-shell,
    .overlay-search-shell input,
    .overlay-search-clear {
      transition: none;
    }
  }
</style>

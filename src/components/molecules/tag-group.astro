---
import Tag from "../atoms/tag.astro";

interface Props {
  class?: string;
  items: {
    label: string;
    variant?: "neutral" | "info" | "success" | "warning";
  }[];
  size?: "compact" | "regular";
}

const { class: className, items, size = "compact" } = Astro.props;
const visibleItems = items.filter(
  (item): item is { label: string; variant?: "neutral" | "info" | "success" | "warning" } =>
    Boolean(item?.label?.trim()),
);
---

{
  visibleItems.length > 0 && (
    <span class:list={["tag-group", className]}>
      {visibleItems.map((item, index) => (
        <span
          class="tag-group-item"
          style={`--tag-offset:${Math.max(visibleItems.length - index - 1, 0)};--tag-z-index:${index + 1};`}
        >
          <Tag label={item.label} variant={item.variant ?? "neutral"} size={size} />
        </span>
      ))}
    </span>
  )
}

<style>
  .tag-group {
    --tag-gap: 0.36rem;
    --tag-overlap: 0.7rem;
    display: inline-grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    align-items: center;
    column-gap: var(--tag-gap);
    min-width: 0;
    isolation: isolate;
    white-space: nowrap;
  }

  .tag-group-item {
    display: inline-flex;
    grid-row: 1;
    position: relative;
    transform: translateX(calc(var(--tag-offset) * var(--tag-overlap)));
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    z-index: var(--tag-z-index);
  }

  .tag-group:is(:hover, :focus-within) .tag-group-item {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-group-item {
      transition: none;
    }
  }
</style>

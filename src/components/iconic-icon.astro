---
import { iconicIcons, type IconicIconName } from "../icons/iconic";

interface Props {
  class?: string;
  name: IconicIconName;
}

const { class: className, name } = Astro.props;
const svg = iconicIcons[name];
---

<span class:list={["iconic-icon", className]} aria-hidden="true" set:html={svg} />

<style>
  .iconic-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1em;
    height: 1em;
    color: inherit;
    line-height: 0;
  }

  .iconic-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

{
  "name": "bradenm.co.uk",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.18.0"
  },
  "homepage": "https://github.com/braden1996/bradenm.co.uk",
  "bugs": {
    "url": "https://github.com/braden1996/bradenm.co.uk/issues"
  },
  "license": "MIT",
  "author": "Braden Marshall <braden1996@hotmail.co.uk>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braden1996/bradenm.co.uk.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun run bookshelf:metadata --build && astro build",
    "check:deployment": "bun scripts/check-deployment.mjs",
    "build:docker": "docker build --output dist .",
    "build:fonts": "docker build --target fonts-out --output public/fonts .",
    "bookshelf:covers": "node ./scripts/sync-bookshelf-covers.mjs",
    "bookshelf:covers:force": "node ./scripts/sync-bookshelf-covers.mjs --force",
    "bookshelf:covers:upgrade": "bun scripts/sync-bookshelf-covers.mjs --upgrade",
    "bookshelf:atlas-assets": "bun scripts/sync-bookshelf-atlas.ts",
    "check:atlas-assets": "bun scripts/sync-bookshelf-atlas.ts --check",
    "site:images": "node ./scripts/sync-site-image-metadata.mjs",
    "check": "bun run check:rulesync && bun run check:atlas-assets && bun run check:metadata && bun run check:format && bun run check:types && bun run check:tool-types && bun run check:lint && bun run check:tests && bun run check:knip && bun run check:spelling",
    "check:rulesync": "rulesync doctor --strict && rulesync generate --check",
    "check:format": "prettier --check --experimental-cli .",
    "check:types": "astro check --tsconfig tsconfig.lib.json",
    "check:tool-types": "tsc --project tsconfig.test.json",
    "check:lint": "bun run check:file-names && oxlint",
    "check:tests": "bun test",
    "check:knip": "knip --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "check:file-names": "bun ./scripts/check-file-names.mjs",
    "check:spelling": "cspell \"**/*.{js,mjs,ts,astro,md}\"",
    "knip": "knip",
    "rulesync:generate": "rulesync generate",
    "fix": "bun run fix:format && bun run fix:lint",
    "fix:format": "prettier --write --experimental-cli .",
    "fix:lint": "oxlint --fix",
    "portrait:silhouette": "node ./scripts/sync-portrait-silhouette.mjs",
    "check:browser": "playwright test",
    "check:performance": "bun scripts/check-performance.mjs",
    "preview:performance": "bun scripts/performance-server.mjs",
    "build:offline": "bun run bookshelf:metadata --offline && astro build",
    "bookshelf:metadata": "bun scripts/sync-bookshelf-metadata.ts",
    "check:metadata": "bun run bookshelf:metadata --check"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "1.0.19",
    "@tanstack/hotkeys": "^0.8.0",
    "astro": "7.3.1",
    "three": "0.185.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cspell/dict-en-gb": "5.0.31",
    "@oxlint/plugins": "1.81.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.1",
    "@types/three": "0.185.4",
    "cspell": "10.2.2",
    "helmlab": "^1.0.0",
    "knip": "6.34.0",
    "lighthouse": "13.4.1",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "rulesync": "16.24.1",
    "sharp": "0.35.4",
    "typescript": "7.0.2"
  }
}
